-- List mutation tests

List[INT] number = [1,2,3];
List[STR] greeting_chars  = ["h","o"];
List[List[List[BOOL]]] booleanos = [[[True, False]]];

show(booleanos);
show(number);
show(greeting_chars);

greeting_chars[0] = "f";
number[0] = 100;
booleanos[0] = [[False]];

show(booleanos);
show(number);
show(greeting_chars);
