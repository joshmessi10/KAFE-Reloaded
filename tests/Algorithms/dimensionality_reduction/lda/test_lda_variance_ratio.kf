import machine;

List[List[FLOAT]] X = [[1.0, 2.0], [2.0, 3.0], [3.0, 3.0], [6.0, 7.0], [7.0, 8.0], [8.0, 7.0], [4.0, 1.0], [5.0, 1.0], [4.5, 2.0]];
List[INT] y = [0, 0, 0, 1, 1, 1, 2, 2, 2];

MACHINE lda = machine.linear_discriminant_analysis(2);
lda.fit(X, y);

show(len(lda.explained_variance_ratio_));
show(len(lda.scalings_));
