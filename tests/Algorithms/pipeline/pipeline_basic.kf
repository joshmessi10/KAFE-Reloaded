import machine;

-- Create pipeline with scaler and model
MACHINE scaler = machine.standard_scaler();
MACHINE lr = machine.linear_regression();

MACHINE pipe = machine.pipeline("scaler", scaler, "model", lr);

-- Train (non-singular data)
List[List[FLOAT]] X_train = [[1.0, 2.0], [2.0, 1.0], [3.0, 4.0], [4.0, 3.0], [5.0, 6.0]];
List[FLOAT] y_train = [3.0, 3.0, 7.0, 7.0, 11.0];
pipe.fit(X_train, y_train);

-- Predict
List[FLOAT] preds = pipe.predict([[6.0, 5.0], [7.0, 8.0]]);
show(preds);

-- Score
FLOAT score = pipe.score([[6.0, 5.0], [7.0, 8.0]], [11.0, 15.0]);
show(score);