import machine;

List[List[FLOAT]] X = [[5.0, 0.1, 3.0], [4.0, 9.2, 6.0], [7.0, 0.3, 1.0], [10.0, 4.4, 8.0]];
List[FLOAT] y = [1.0, 2.0, 3.0, 4.0];

MACHINE rfe = machine.recursive_feature_elimination(2);
rfe.fit(X, y);

show(rfe.selected_indices_);
show(rfe.support_);
show(len(rfe.transform(X)[0]));
