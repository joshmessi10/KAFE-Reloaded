INT age = 28;
INT experience = 4;
INT courses = 6;

if (age >= 18) :
    if (experience == 0) :
        show("Rejected: adult without experience");
      elif (experience < 3) :
        if (courses >= 5) :
            show("Accepted as junior in training");
          else :
            show("Rejected: insufficient experience and training");
        ;
      else :
        if (courses >= 7) :
            show("Accepted as mid-level with excellent training");
          elif (courses >= 4) :
            show("Accepted as mid-level with acceptable training");
          else :
            show("Accepted as mid-level; further training is recommended");
        ;
    ;
  else :
    show("Rejected: underage");
;
