import machine;
import pardos;
import math;

List[List[FLOAT]] X = [[0.0], [0.1], [10.0], [10.1]];
MACHINE km = machine.kmeans(2, 20, 42);
show(len(km.fit_predict(X)));
show(km.score(X) <= 0.0);
MACHINE db = machine.dbscan(0.5, 2);
db.fit(X);
show(len(db.core_sample_indices()));
MACHINE ag = machine.agglomerative_clustering(2, "single");
ag.fit(X);
show(len(ag.labels_));
MACHINE gm = machine.gaussian_mixture(2, 10, 0.001, 42);
show(len(gm.fit_predict(X)));
MACHINE lda = machine.linear_discriminant_analysis(1);
show(len(lda.fit_transform([[1.0, 2.0], [2.0, 3.0], [3.0, 3.0], [6.0, 7.0], [7.0, 8.0], [8.0, 7.0]], [0, 0, 0, 1, 1, 1])[0]));
PARDOS df = pardos.DataFrame(["color"], [["red"], ["blue"], ["red"]]);
MACHINE oh = machine.one_hot_encoder();
oh.fit(df, ["color"]);
show(oh.transform(df));
MACHINE oe = machine.ordinal_encoder();
oe.fit(df, ["color"]);
show(oe.transform(df));
MACHINE imp = machine.simple_imputer("median");
imp.fit([[1.0, 2.0], [3.0, 4.0]]);
show(imp.transform([[math.nan, math.nan]]));
MACHINE poly = machine.polynomial_features(2, True);
poly.fit([[1.0, 2.0], [3.0, 4.0]]);
show(len(poly.transform([[1.0, 2.0]])[0]));
MACHINE selector = machine.variance_threshold(0.0);
selector.fit([[1.0, 0.0], [2.0, 0.0]]);
show(selector.transform([[3.0, 0.0]]));
MACHINE model = machine.linear_regression();
model.fit([[1.0], [2.0], [3.0]], [2.0, 4.0, 6.0]);
show(model.score([[1.0], [2.0], [3.0]], [2.0, 4.0, 6.0], machine.mean_squared_error) < 0.000001);
