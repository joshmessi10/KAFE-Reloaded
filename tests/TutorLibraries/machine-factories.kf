import machine;

-- Factory coverage uses the actual positional DSL forms without backend keywords.
MACHINE a = machine.linear_regression();
MACHINE b = machine.label_encoder();
MACHINE c = machine.one_hot_encoder();
MACHINE d = machine.ordinal_encoder();
MACHINE e = machine.pca(1);
MACHINE f = machine.standard_scaler();
MACHINE g = machine.minmax_scaler();
MACHINE h = machine.simple_imputer("mean");
MACHINE i = machine.simple_imputer_constant(0.0);
MACHINE j = machine.logistic_regression(0.1, 20);
MACHINE k = machine.knn(1);
MACHINE l = machine.decision_tree_classifier("gini", 2, 2, 1);
MACHINE m = machine.kmeans(2, 10, 42);
MACHINE n = machine.gaussian_nb();
MACHINE o = machine.dbscan(0.5, 2);
MACHINE p = machine.random_forest_classifier(3, 2, 2, 1);
MACHINE q = machine.random_forest_regressor(3, 2, 2, 1);
MACHINE r = machine.ridge_regression(1.0, True, 20);
MACHINE s = machine.lasso_regression(1.0, True, 20);
MACHINE t = machine.svr(1.0, 0.1, "linear");
MACHINE u = machine.svm(1.0, "linear", 20);
MACHINE v = machine.train_test_split([[1.0], [2.0], [3.0], [4.0]], [0, 0, 1, 1], 0.5, 42, False);
MACHINE w = machine.stratified_train_test_split([[1.0], [2.0], [3.0], [4.0]], [0, 0, 1, 1], 0.5, 42);
MACHINE x = machine.tokenizer(20, "<oov>");
show(len(machine.k_fold(4, 2, False, 42)));
MACHINE z = machine.cross_val_score(2, "accuracy", 42);
MACHINE aa = machine.grid_search_cv(2, "accuracy", 42);
MACHINE ab = machine.randomized_search_cv(2, 2, "accuracy", 42);
MACHINE ac = machine.pipeline("scale", f, "model", a);
MACHINE ad = machine.polynomial_features(2, True);
MACHINE ae = machine.elastic_net(1.0, 0.5, True, 20);
MACHINE af = machine.agglomerative_clustering(2, "ward");
MACHINE ag = machine.ada_boost_classifier(3, 1.0, 42);
MACHINE ah = machine.gradient_boosting_classifier(3, 0.1, 2);
MACHINE ai = machine.gradient_boosting_regressor(3, 0.1, 2);
MACHINE aj = machine.variance_threshold(0.0);
MACHINE ak = machine.recursive_feature_elimination(1, 20);
MACHINE al = machine.robust_scaler(1, 1, 25);
MACHINE am = machine.decision_tree_regressor("mse", 2, 2, 1);
MACHINE an = machine.knn_regressor(1, "distance");
MACHINE ao = machine.gaussian_mixture(2, 10, 0.001, 42);
MACHINE ap = machine.linear_discriminant_analysis(1);
show(len(v[0]));
show(len(w[0]));
show(x.vocabulary_size);
show("42 MACHINE factories reached");
