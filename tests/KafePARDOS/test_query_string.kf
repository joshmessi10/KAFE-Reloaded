import pardos;


PARDOS df = pardos.read_csv("dataframe_basic_operations.csv");

show("--- DataFrame Original ---");
show(df);

show("--- Simple Filter: Age > 30 ---");
PARDOS older_rows = df.query("age > 30");
show(older_rows);

show("--- Multiple Filter: Age > 28 && salary > 50000 ---");
PARDOS multiple = df.query("age > 28 && salary > 50000");
show(multiple);

show("--- Multiple Filter (OR): name == 'Bob' || name == 'Eva' ---");
PARDOS o_filtrado = df.query("name == 'Bob' || name == 'Eva'");
show(o_filtrado);
