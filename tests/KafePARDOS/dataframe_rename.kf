import pardos;

-- Test rename() method
PARDOS df = pardos.read_csv("column_manipulation_test.csv");

show("Original DataFrame:");
show(df);

-- Rename 'name' to 'name'
PARDOS df2 = df.rename("name", "name");
show("After renaming 'name' to 'name':");
show(df2);

-- Rename 'age' to 'age'
PARDOS df3 = df2.rename("age", "age");
show("After renaming 'age' to 'age':");
show(df3);
