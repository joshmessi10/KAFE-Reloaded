import pardos;

-- Read the test CSV (test1.csv is in tests/KafePARDOS)
PARDOS df = pardos.read_csv("dataframe_basic_operations.csv");

-- Display the first three rows
PARDOS first3 = df.head(3);
show(df.head(3));

-- Display the last two rows
PARDOS last2 = df.tail(2);
show(last2);

-- Shape: now returns a DataFrame with rows “Rows” y “Columns”
show(df.shape());

-- "age" column: list of INT → List[INT]
List[INT] ages = df.col("age");
show(ages);

show(df.dtypes());

show(df.info());

PARDOS description = df.describe();
show(description);
