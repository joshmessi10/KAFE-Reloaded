import pardos;

PARDOS df = pardos.read_csv("dataframe_basic_operations.csv");

show("--- value_counts: name ---");
PARDOS vc = df.value_counts("name");
show(vc);

show("--- mean: salary ---");
show(df.mean("salary"));

show("--- sum: salary ---");
show(df.sum("salary"));

show("--- agg sum: salary ---");
show(df.agg("salary", "sum"));

show("--- agg mean: age ---");
show(df.agg("age", "mean"));

show("--- agg min: salary ---");
show(df.agg("salary", "min"));

show("--- agg max: salary ---");
show(df.agg("salary", "max"));

show("--- agg count: salary ---");
show(df.agg("salary", "count"));
