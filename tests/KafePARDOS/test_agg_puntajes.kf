import pardos;

PARDOS df = pardos.read_csv("dataframe_export.csv");

show("--- mean: score ---");
show(df.mean("score"));

show("--- sum: score ---");
show(df.sum("score"));

show("--- agg max: score ---");
show(df.agg("score", "max"));

show("--- agg min: score ---");
show(df.agg("score", "min"));
