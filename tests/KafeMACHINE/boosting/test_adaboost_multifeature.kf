import machine;

List[List[FLOAT]] X = [[1.0, 1.0], [2.0, 2.0], [3.0, 3.0], [4.0, 4.0], [5.0, 5.0], [6.0, 6.0]];
List[INT] y = [0, 0, 0, 1, 1, 1];

MACHINE ab = machine.ada_boost_classifier(10, 1.0, 42);
ab.fit(X, y);

List[INT] preds = ab.predict([[2.0, 2.0], [5.0, 5.0]]);
show(preds);

FLOAT acc = ab.score(X, y);
show(acc);
