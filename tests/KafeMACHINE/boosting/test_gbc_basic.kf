import machine;

List[List[FLOAT]] X = [[1.0, 2.0], [2.0, 3.0], [3.0, 4.0], [4.0, 5.0], [5.0, 6.0], [6.0, 7.0]];
List[INT] y = [0, 0, 0, 1, 1, 1];

MACHINE gbc = machine.gradient_boosting_classifier(10, 0.1, 2);
gbc.fit(X, y);

List[INT] preds = gbc.predict([[2.5, 3.5], [5.5, 6.5]]);
show(preds);

FLOAT acc = gbc.score(X, y);
show(acc);
