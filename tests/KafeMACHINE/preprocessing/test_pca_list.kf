import machine;

-- PCA with raw 2D list (not PARDOS)
-- 3D data: X=(1,2,3), Y=(2,4,6), Z has approx relationship
List[List[FLOAT]] data = [[1.0, 2.0, 2.5], [2.0, 4.0, 5.0], [3.0, 6.0, 7.5]];

MACHINE pca_model = machine.pca(2);
pca_model.fit(data);
pca_model.round(4);

show("Components:");
show(pca_model.components_);
