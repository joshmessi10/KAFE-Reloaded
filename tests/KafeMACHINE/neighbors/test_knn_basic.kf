import machine;

List[List[FLOAT]] X = [[1.0, 1.0], [1.0, 2.0], [2.0, 1.0],
                        [5.0, 5.0], [5.0, 6.0], [6.0, 5.0]];
List[INT] y = [0, 0, 0, 1, 1, 1];

MACHINE model = machine.knn(3);
model.fit(X, y);

List[INT] preds = model.predict([[1.0, 1.0], [5.0, 5.0], [3.0, 3.0]]);
show("Predictions:");
show(preds);
