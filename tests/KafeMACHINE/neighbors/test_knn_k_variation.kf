import machine;

List[List[FLOAT]] X = [[1.0, 1.0], [2.0, 2.0], [3.0, 3.0],
                        [10.0, 10.0], [11.0, 11.0], [12.0, 12.0]];
List[INT] y = [0, 0, 0, 1, 1, 1];

MACHINE m1 = machine.knn(1);
m1.fit(X, y);
show("k=1:");
show(m1.predict([[5.0, 5.0]]));

MACHINE m3 = machine.knn(3);
m3.fit(X, y);
show("k=3:");
show(m3.predict([[5.0, 5.0]]));

MACHINE m5 = machine.knn(5);
m5.fit(X, y);
show("k=5:");
show(m5.predict([[5.0, 5.0]]));
