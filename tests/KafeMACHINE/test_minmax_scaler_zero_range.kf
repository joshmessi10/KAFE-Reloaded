import machine;

-- All values identical → min=max, scale=0
List[List[FLOAT]] data = [[5.0, 5.0], [5.0, 5.0], [5.0, 5.0]];

MACHINE scaler = machine.minmax_scaler();
scaler.fit(data);
show("data_min_:");
show(scaler.data_min_);
show("data_max_:");
show(scaler.data_max_);
show("scale_:");
show(scaler.scale_);

List[List[FLOAT]] transformed = scaler.transform(data);
show("Transformed:");
show(transformed);
