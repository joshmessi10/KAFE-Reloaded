import machine;

List[List[FLOAT]] X = [[1.0, 1.0], [1.0, 2.0], [2.0, 1.0],
                        [5.0, 5.0], [5.0, 6.0], [6.0, 5.0]];

MACHINE model = machine.kmeans(2, 100, 42);
model.fit(X);

List[INT] labels = model.labels();
show("Labels:");
show(labels);

List[List[FLOAT]] centers = model.cluster_centers();
show("Centers:");
show(centers);

FLOAT inertia = model.inertia();
show("Inertia:");
show(inertia);
