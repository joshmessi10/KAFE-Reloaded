import machine;

List[List[FLOAT]] X = [[1.0, 2.0], [1.5, 1.8], [5.0, 8.0], [8.0, 8.0], [1.0, 0.6], [9.0, 11.0]];

MACHINE gmm = machine.gaussian_mixture(2, 100, 1e-3, 42);
gmm.fit(X);

List[INT] labels = gmm.predict(X);
show(labels);
show([int(gmm.weights_[0] * 10000000000.0 + 0.5) / 10000000000.0, int(gmm.weights_[1] * 10000000000.0 + 0.5) / 10000000000.0]);
show([[int(gmm.means_[0][0] * 10000000000.0 + 0.5) / 10000000000.0, int(gmm.means_[0][1] * 10000000000.0 + 0.5) / 10000000000.0], [int(gmm.means_[1][0] * 10000000000.0 + 0.5) / 10000000000.0, int(gmm.means_[1][1] * 10000000000.0 + 0.5) / 10000000000.0]]);
