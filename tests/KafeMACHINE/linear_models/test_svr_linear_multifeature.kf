import machine;

List[List[FLOAT]] X = [[1.0, 2.0], [2.0, 3.0], [3.0, 4.0], [4.0, 5.0], [5.0, 6.0]];
List[FLOAT] y = [3.0, 5.0, 7.0, 9.0, 11.0];

MACHINE svr_model = machine.svr(1.0, 0.1, "linear");
svr_model.fit(X, y);

List[FLOAT] preds = svr_model.predict([[1.5, 2.5], [4.5, 5.5]]);
show(preds);

FLOAT r2 = svr_model.score(X, y);
show(r2);
