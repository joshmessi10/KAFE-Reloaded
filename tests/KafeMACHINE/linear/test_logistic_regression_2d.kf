import machine;

-- Binary classification with 2 features
-- Class 1 when feature1 > feature2, else class 0
List[List[FLOAT]] X = [[1.0, 2.0], [2.0, 4.0], [3.0, 6.0], [4.0, 5.0], [5.0, 3.0], [6.0, 2.0], [7.0, 1.0], [8.0, 4.0]];
List[INT] y = [0, 0, 0, 0, 1, 1, 1, 1];

MACHINE lr = machine.logistic_regression(0.1, 5000);
lr.fit(X, y);

List[INT] preds = lr.predict([[2.0, 3.0], [5.0, 4.0], [1.0, 5.0], [8.0, 1.0]]);
show("Predictions:");
show(preds);

FLOAT acc = lr.score(X, y);
show("Accuracy:");
show(acc);
