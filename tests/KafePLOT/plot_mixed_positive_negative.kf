import plot;

-- Training data
List[FLOAT] X = [0.0, 1.0, 2.0, 3.0, 4.0];
List[FLOAT] Y = [1.0, 2.3, 3.1, 3.9, 5.2];

-- Coefficients obtained (m, b)
FLOAT m = 0.95;
FLOAT b = 0.2;

-- 1) Draw training points
plot.figure();
plot.title("Linear regression (points vs. line)");
plot.xlabel("X");
plot.ylabel("Y");
plot.pointColor("blue");
plot.grid(True);
plot.pointSize(5);
plot.graph(X, Y, "point");  -- draws only blue points

-- 2) Build vector X for the line and vector Y where y = m*x + b
List[FLOAT] X_line = [0.0, 4.0];                           -- two endpoints are enough
List[FLOAT] Y_line = [m * 0.0 + b, m * 4.0 + b];

-- 3) Draw the line
plot.color("red");
plot.pointColor("red");          -- the line points are also red
plot.pointSize(3);
plot.graph(X_line, Y_line, "line");  -- draws only the line

-- 4) Legend
plot.legend("blue: training points ; red: estimated line");

-- 5) Render final
plot.render();
