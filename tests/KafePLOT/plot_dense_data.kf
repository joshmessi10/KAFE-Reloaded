-- test_clasificacion_binaria.kf

import plot;

-- 1) Example data: list of pairs [x, y]
List[List[INT]] data = [
    [1,  2],
    [2,  1],
    [3,  1],
    [2,  5],
    [5,  2],
    [6,  6],
    [7,  3],
    [8,  8],
    [9,  7],
    [8,  2]
];

-- 2) Create two empty lists for each class
List[List[INT]] class_one = [];
List[List[INT]] class_zero = [];

-- 3) Define a linear threshold: x + y > 8 selects class_one
INT threshold = 8;

-- 4) Iterate over each data point p and classify it
for (p in data):
    INT xv = p[0];
    INT yv = p[1];
    if (xv + yv > threshold):
        -- belongs to class_one (red)
        append(class_one, p);
    else:
        -- belongs to class_zero (blue)
        append(class_zero, p);
    ;
;

-- 5) Initialize the figure and configure titles/labels
plot.figure();
plot.title("Binary classification: x + y > 8");
plot.xlabel("X");
plot.ylabel("Y");
plot.grid(True);

-- 6) Plot all class-one points in red as [x, y] pairs
plot.color("red");
plot.pointColor("red");
plot.pointSize(6);
plot.graph(class_one,"point");

-- 7) Plot all class-zero points in blue
plot.color("blue");
plot.pointColor("blue");
plot.pointSize(6);
plot.graph(class_zero,"point");

-- 8) Draw the decision line x + y = 8 (equivalent to y = 8 - x)
List[INT] x_line = [0, 10];
List[INT] y_line = [threshold - x_line[0], threshold - x_line[1]];
plot.color("green");
plot.graph(x_line, y_line, "line");

-- 9) Add a legend describing each color
--     The string is separated by semicolons: "color: text ; color: text ; ..."
plot.legend("red: Class 1 ; blue: Class 0 ; green: Decision boundary");

-- 10) Render the final SVG
plot.render();
