-- test_clustering.kf

import plot;

-- ================================================================
-- Clustering example (k = 2) with hard-coded 2D data
-- ================================================================

-- 1) Define the data (each item is an [x, y] pair)
--    and the labels assigned by the k-means algorithm (0 or 1).
List[List[FLOAT]] data = [
    [1.0, 2.0],
    [1.5, 1.8],
    [5.0, 8.0],
    [8.0, 8.0],
    [1.0, 0.6],
    [9.0, 11.0]
];
-- Assume k-means returned these labels for each point:
--   indexes:    0    1    2    3    4    5
List[INT] labels = [0,   0,   1,   1,   0,   1];

-- 2) Prepare empty lists to store each cluster's coordinates
List[FLOAT] X0 = [];
List[FLOAT] Y0 = [];
List[FLOAT] X1 = [];
List[FLOAT] Y1 = [];

-- 3) To iterate over all points by index, create a list of indexes
List[INT] indexes = [0, 1, 2, 3, 4, 5];

-- 4) Use a for loop with conditionals to separate points by label
for (i in indexes):
    FLOAT xi = data[i][0];
    FLOAT yi = data[i][1];
    INT label = labels[i];

    if (label == 0):
        -- Belong to cluster 0
        append(X0, xi);
        append(Y0, yi);
    else:
        -- Belong to cluster 1
        append(X1, xi);
        append(Y1, yi);
    ;
;

-- 5) Assume these are the two centers returned by k-means:
--    Center of cluster 0: (1.1667, 1.4667)
--    Center of cluster 1: (7.3333, 9.0000)
List[FLOAT] CX = [1.1667, 7.3333];
List[FLOAT] CY = [1.4667, 9.0000];

-- 6) Now plot:
plot.figure();
plot.title("Clustering k-means (k=2)");
plot.xlabel("X");
plot.ylabel("Y");
plot.grid(True);

-- 6a) Draw the points in cluster 0 in red (points only)
plot.color("none");       -- with line style, none means no line is drawn
plot.pointColor("red");
plot.pointSize(6);
plot.graph(X0, Y0, "point");

-- 6b) Draw the points in cluster 1 in green (points only)
plot.pointColor("green");
plot.graph(X1, Y1, "point");

-- 6c) Draw both cluster centers as larger black points
plot.pointColor("black");
plot.pointSize(8);
plot.graph(CX, CY, "point");

-- 7) Legend showing which color corresponds to each group (separated by “;”)
--    Expected format: "color1: text1 ; color2: text2 ; color3: text3"
plot.legend(
    "red: cluster 0 ; green: cluster 1 ; black: centers"
);

-- 8) Render the final SVG
plot.render();
