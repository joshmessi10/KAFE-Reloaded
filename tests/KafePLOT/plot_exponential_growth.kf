import plot;

-- 1) Initialize the figure and configure labels
plot.figure();
plot.title("Multiple data series");
plot.xlabel("X-axis");
plot.ylabel("Y-axis");
plot.grid(True);

-- 2) Series 1: red points
plot.color("red");
plot.pointColor("red");
plot.pointSize(4);
List[INT] x1 = [1, 2, 3, 4, 5];
List[INT] y1 = [2, 3, 1, 5, 4];
plot.graph(x1, y1);

-- 3) Series 2: blue points
plot.color("blue");
plot.pointColor("blue");
plot.pointSize(4);
List[INT] x2 = [1, 2, 3, 4, 5];
List[INT] y2 = [5, 4, 3, 2, 1];
plot.graph(x2, y2);

-- 4) Series 3: points dark green
plot.color("black");
plot.pointColor("green");
plot.pointSize(4);
List[INT] x3 = [1, 3, 5];
List[INT] y3 = [4, 2, 5];
plot.graph(x3, y3);

-- 5) Add a legend (with ; between entries)
plot.legend("red: S1; blue: S2; black: S3");

-- 6) Draw the entire SVG
plot.render();
