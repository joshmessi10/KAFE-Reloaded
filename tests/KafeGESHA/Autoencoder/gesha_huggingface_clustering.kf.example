-- Ejemplo extenso: Hugging Face -> GESHA -> K-Means
-- Requiere: pip install datasets

import huggingface;
import geshaDeep;
import machine;
import plot;

show("=== Clustering de Iris descargado desde Hugging Face ===");
List[STR] columnas = ["SepalLengthCm", "SepalWidthCm", "PetalLengthCm", "PetalWidthCm"];
List[List[FLOAT]] X = huggingface.load_dataset_matrix("scikit-learn/iris", columnas, "train", 0);
show("Muestras cargadas:");
show(len(X));
-- Estandarización aproximada de Iris para conservar variación 2D.
List[List[FLOAT]] Xn = [];
for (i in range(0, len(X))):
    append(Xn, [(X[i][0] - 5.84) / 0.83, (X[i][1] - 3.06) / 0.44, (X[i][2] - 3.76) / 1.76, (X[i][3] - 1.20) / 0.76]);
;

-- Autoencoder 4 -> 3 -> 2 -> 3 -> 4.
GESHA encoder1 = geshaDeep.create_dense(3, "tanh", [4], 0.0, 11);
GESHA encoder2 = geshaDeep.create_dense(2, "tanh", [3], 0.0, 12);
GESHA decoder1 = geshaDeep.create_dense(3, "tanh", [2], 0.0, 13);
GESHA decoder2 = geshaDeep.create_dense(4, "linear", [3], 0.0, 14);
GESHA autoencoder = geshaDeep.sequential([encoder1, encoder2, decoder1, decoder2]);
autoencoder.compile("adam", "mse", []); 
autoencoder.set_lr(0.01);
autoencoder.fit(Xn, Xn, 25, 16);

-- Se reutiliza el encoder para obtener el espacio latente.
GESHA encoder = geshaDeep.sequential([encoder1, encoder2]);
List[List[FLOAT]] Z = encoder.predict(Xn);

MACHINE model = machine.kmeans(3, 100, 42);
model.fit(Z);
List[INT] labels = model.labels();
show("Etiquetas:");
show(labels);
show("Centros latentes:");
show(model.cluster_centers());
show("Inercia:");
show(model.inertia());

-- Grafica los tres clusters en el espacio latente (KafePLOT).
List[FLOAT] x0 = [0.0];
List[FLOAT] y0 = [0.0];
List[FLOAT] x1 = [0.0];
List[FLOAT] y1 = [0.0];
List[FLOAT] x2 = [0.0];
List[FLOAT] y2 = [0.0];
-- Se recorren las muestras sin conocer de antemano su distribución.
for (i in range(0, len(Z))):
    INT cluster = labels[i];
    if (cluster == 0):
        append(x0, Z[i][0]);
        append(y0, Z[i][1]);
    else:
        if (cluster == 1):
            append(x1, Z[i][0]);
            append(y1, Z[i][1]);
        else:
            append(x2, Z[i][0]);
            append(y2, Z[i][1]);
        ;
    ;
;
plot.figure();
plot.title("Iris: clusters en el espacio latente GESHA");
plot.xlabel("Latente 1");
plot.ylabel("Latente 2");
plot.pointColor("blue");
plot.graph(x0, y0, "point");
plot.pointColor("red");
plot.graph(x1, y1, "point");
plot.pointColor("green");
plot.graph(x2, y2, "point");

-- render() guarda la figura SVG junto al programa KAFE.
plot.render();
