-- ============================================
-- RNN sintético SIN red: clasificación por suma
-- ============================================
-- 16 secuencias construidas en el propio .kf:
--   5 timesteps x 1 feature, valores en niveles
--   altos/bajos con jitter determinista.
--   La etiqueta binaria se deriva de la SUMA de
--   la secuencia (suma >= 2.5 -> 1), de modo que
--   la RNN debe "recordar" el agregado temporal.
--
-- Arquitectura: SimpleRNN(4, tanh) -> Dense(1, sigmoid)
-- Perdida: binary crossentropy, Adam.
-- ============================================

import gesha;
import machine;

show("=== RNN sintético: suma de la secuencia ===");

List[List[List[FLOAT]]] X = [];
List[INT] y = [];
INT i = 0;
while (i < 16):
    -- Nivel alto en muestras pares, bajo en impares
    FLOAT nivel = 0.0;
    if (i % 2 == 0):
        nivel = 1.0;
    ;
    FLOAT suma = 0.0;
    List[List[FLOAT]] secuencia = [];
    INT j = 0;
    while (j < 5):
        FLOAT valor = nivel + float((i * (j + 1)) % 3) * 0.05;
        List[FLOAT] paso = [valor];
        append(secuencia, paso);
        suma = suma + valor;
        j = j + 1;
    ;
    append(X, secuencia);
    -- Etiqueta binaria derivada de la suma de la secuencia
    INT etiqueta = 0;
    if (suma >= 2.5):
        etiqueta = 1;
    ;
    append(y, etiqueta);
    i = i + 1;
;

show("Muestras (16) y forma de una secuencia:");
show([len(X), len(X[0]), len(X[0][0])]);
show("Etiquetas:");
show(y);

-- SimpleRNN(4, tanh) sobre [5 timesteps, 1 feature] -> Dense(1, sigmoid)
GESHA rnn = gesha.create_rnn(4, "tanh", [5, 1], False, 7);
GESHA salida = gesha.create_dense(1, "sigmoid", [4], 0.0, 8, gesha.glorot_uniform(8));
GESHA modelo = gesha.sequential([rnn, salida]);
modelo.compile("adam", "bce", []);
modelo.set_lr(0.01);

show("Entrenando RNN (4 unidades, 25 epocas)...");
modelo.fit(X, y, 25, 4);

List[INT] pred = modelo.predict_label(X);
show("Accuracy: ");
show(machine.accuracy_score(y, pred));
show("Primeras 4 predicciones (predicho vs real):");
INT k = 0;
while (k < 4):
    show(str(pred[k]) + " vs " + str(y[k]));
    k = k + 1;
;
