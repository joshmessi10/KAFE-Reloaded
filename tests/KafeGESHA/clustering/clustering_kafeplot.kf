import pardos;
import geshaDeep;
import plot;

-- Cargar datos con PARDOS
PARDOS df = pardos.read_csv("../tests/data/clustering_sample.csv");
List[List[FLOAT]] X_train = pardos.to_matrix(df);

-- Crear modelo secuencial para clustering
GESHA layer1 = geshaDeep.create_dense(4, "relu", [2], 0.0, 42);
GESHA layer2 = geshaDeep.create_dense(2, "softmax", [], 0.0, 42);
GESHA model  = geshaDeep.sequential([layer1, layer2]);

model.compile("adam", "mse", []);
model.fit(X_train, [], 20, 1);

-- Separar clusters
List[FLOAT] c0_x = [];
List[FLOAT] c0_y = [];
List[FLOAT] c1_x = [];
List[FLOAT] c1_y = [];

for (p in X_train):
    INT cluster_id = model.predict_label(p);
    if (cluster_id == 0):
        append(c0_x, p[0]);
        append(c0_y, p[1]);
    else:
        append(c1_x, p[0]);
        append(c1_y, p[1]);
    ;
;

-- Graficar con KafePlot
plot.figure();
plot.title("Test Clustering KafePlot");
plot.xlabel("X1");
plot.ylabel("X2");
plot.grid(True);

if (len(c0_x) > 0):
    plot.color("blue");
    plot.pointColor("blue");
    plot.pointSize(5);
    plot.graph(c0_x, c0_y, "point");
;

if (len(c1_x) > 0):
    plot.color("red");
    plot.pointColor("red");
    plot.pointSize(5);
    plot.graph(c1_x, c1_y, "point");
;

plot.render();
show("Clustering plot rendered successfully");
