import geshaDeep;

GESHA inputs = geshaDeep.input_layer([2]);
GESHA layer = geshaDeep.create_dense(2, "relu", [2], 0.0, 42);
GESHA outputs = layer.connect(inputs);
GESHA model = geshaDeep.functional(inputs, outputs);
List[FLOAT] result = model.predict([1.0, 2.0]);
show(len(result));
show(result[0] >= 0.0);
show(result[1] >= 0.0);
