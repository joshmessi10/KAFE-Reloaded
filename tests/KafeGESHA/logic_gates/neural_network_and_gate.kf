import gesha;

-- Dataset AND
List[List[INT]] x_train = [
    [0, 0],
    [0, 1],
    [1, 0],
    [1, 1]
];
List[INT] y_train = [0, 0, 0, 1];

GESHA layer = gesha.create_dense(1, "sigmoid", [2], 0.0, 42);
GESHA model = gesha.sequential([layer]);

model.compile("sgd", "binary_crossentropy", ["accuracy"]);
model.fit(x_train, y_train, 100, 1);

-- Test the four points
for (p in x_train):
    List[FLOAT] probs = model.predict_proba(p);
    FLOAT prob = probs[0];  -- probability of class 1
    INT   lbl  = model.predict_label(p);  -- label 0/1
    show(str(p) + " -> prob=" + str(prob) + ", label=" + str(lbl));
;
