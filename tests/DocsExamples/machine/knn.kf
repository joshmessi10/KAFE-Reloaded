import machine;
import math;

List[List[FLOAT]] pets = [[25.0, 4.0], [30.0, 5.0], [28.0, 4.5], [60.0, 25.0], [55.0, 20.0], [65.0, 30.0]];
List[INT] kind = [0, 0, 0, 1, 1, 1];

MACHINE model = machine.knn(3);
model.fit(pets, kind);

show(model.predict([[27.0, 4.0], [58.0, 22.0], [45.0, 14.0]]));

List[List[FLOAT]] p = model.predict_proba([[45.0, 14.0]]);
show(math.round(p[0][0], 2));
show(math.round(p[0][1], 2));
show(model.score(pets, kind));
