import machine;
import math;

List[List[FLOAT]] days = [[30.0, 10.0], [28.0, 20.0], [25.0, 30.0],
                          [15.0, 80.0], [12.0, 90.0], [18.0, 70.0]];
List[INT] rain = [0, 0, 0, 0, 1, 1];

MACHINE model = machine.gradient_boosting_classifier(20, 0.5, 2);
model.fit(days, rain);

show(model.predict([[29.0, 15.0], [13.0, 85.0]]));
show(model.score(days, rain));
show(model.classes_);
show(math.round(model.initial_prediction_, 2));
