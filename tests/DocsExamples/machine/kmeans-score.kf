import machine;
import math;

List[List[FLOAT]] fruits = [[1.0, 1.0], [1.0, 2.0], [2.0, 1.0],
                            [8.0, 8.0], [8.0, 9.0], [9.0, 8.0]];

MACHINE one = machine.kmeans(1, 100, 42);
one.fit(fruits);
show(math.round(one.inertia(), 2));

MACHINE two = machine.kmeans(2, 100, 42);
List[INT] groups = two.fit_predict(fruits);
show(groups);
show(math.round(two.inertia(), 2));
show(math.round(two.score(fruits), 2));
show(two.labels());
show(two.n_clusters);
