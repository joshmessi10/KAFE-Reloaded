import machine;

List[List[FLOAT]] houses = [[1.0, 1.0], [1.0, 2.0], [2.0, 1.0], [2.0, 2.0], [3.0, 2.0],
                            [6.0, 6.0],
                            [8.0, 8.0], [8.0, 9.0], [9.0, 8.0]];

MACHINE model = machine.dbscan(1.0, 3);
List[INT] groups = model.fit_predict(houses);

show(groups);
show(model.n_clusters());
show(model.core_sample_indices());
