import math;

List[FLOAT] cats = [1.0, 2.0, 3.0];

FLOAT mean = 0.0;
for (i in range(0, len(cats))):
    mean = mean + cats[i] / len(cats);
;
show(mean);

FLOAT spread = 0.0;
for (i in range(0, len(cats))):
    spread = spread + (cats[i] - mean) * (cats[i] - mean) / len(cats);
;
show(math.round(spread, 2));
