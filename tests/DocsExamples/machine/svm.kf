import machine;
import math;

List[List[FLOAT]] fruit = [[1.0, 2.0], [2.0, 1.0], [2.0, 3.0], [6.0, 6.0], [7.0, 5.0], [6.0, 8.0]];
List[INT] kind = [0, 0, 0, 1, 1, 1];

MACHINE model = machine.svm();
model.fit(fruit, kind);

show(model.classes_);
show(model.predict([[2.0, 2.0], [7.0, 7.0]]));
show(model.score(fruit, kind));
List[List[FLOAT]] sure = model.predict_proba([[2.0, 2.0]]);
show(math.round(sure[0][0], 2));
show(math.round(sure[0][1], 2));
