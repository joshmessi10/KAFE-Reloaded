import machine;
import math;

List[List[FLOAT]] fruits = [[1.0, 1.0], [1.0, 2.0], [2.0, 1.0],
                            [8.0, 8.0], [8.0, 9.0], [9.0, 8.0]];

MACHINE model = machine.kmeans(2, 100, 42);
model.fit(fruits);

show(model.labels_);
List[List[FLOAT]] centers = model.cluster_centers_;
show(math.round(centers[0][0], 2));
show(math.round(centers[0][1], 2));
show(math.round(centers[1][0], 2));
show(math.round(centers[1][1], 2));
show(math.round(model.inertia_, 2));

List[INT] guess = model.predict([[2.0, 2.0], [7.0, 9.0]]);
show(guess);
