import machine;
import math;

List[FLOAT] size = [20.0, 30.0, 40.0, 50.0, 60.0];
List[FLOAT] price = [9.0, 12.0, 14.0, 19.0, 21.0];

MACHINE model = machine.linear_regression();
model.fit(size, price);

List[FLOAT] slope = model.coef_;
show(math.round(slope[0], 2));
show(math.round(model.intercept_, 2));
show(math.round(model.score(size, price), 3));
