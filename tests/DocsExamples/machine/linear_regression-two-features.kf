import machine;
import math;

List[List[FLOAT]] X = [[1.0, 0.0], [2.0, 1.0], [3.0, 0.0], [4.0, 1.0], [5.0, 2.0]];
List[FLOAT] y = [3.0, 8.0, 7.0, 12.0, 17.0];

MACHINE model = machine.linear_regression();
model.fit(X, y);

List[FLOAT] weights = model.coef_;
show(math.round(weights[0], 2));
show(math.round(weights[1], 2));
show(math.round(model.intercept_, 2));
