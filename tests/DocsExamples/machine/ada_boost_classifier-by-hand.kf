import math;

FLOAT error = 1.0 / 5.0;
FLOAT alpha = 0.5 * math.log((1.0 - error) / error);
show(math.round(alpha, 2));

FLOAT wrong = 0.2 * math.exp(alpha);
FLOAT right = 0.2 * math.exp(0.0 - alpha);
FLOAT total = wrong + 4.0 * right;
show(math.round(wrong / total, 3));
show(math.round(right / total, 3));
