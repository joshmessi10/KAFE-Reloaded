import machine;

List[List[FLOAT]] fruits = [[100.0, 2.0], [110.0, 3.0], [90.0, 2.0], [150.0, 7.0], [160.0, 8.0], [140.0, 6.0], [300.0, 5.0], [320.0, 4.0], [280.0, 5.0]];
List[INT] kind = [0, 0, 0, 1, 1, 1, 2, 2, 2];

MACHINE model = machine.decision_tree_classifier();
model.fit(fruits, kind);

show(model.predict([[105.0, 2.5], [155.0, 7.5], [310.0, 4.5]]));
show(model.score(fruits, kind));
show(model.classes_);
show(model.n_features_);
show(model.tree_);
