import gesha;

List[List[List[FLOAT]]] series = [
    [[0.1], [0.2], [0.3]], [[0.2], [0.4], [0.6]], [[0.0], [0.3], [0.5]],
    [[0.9], [0.6], [0.3]], [[0.8], [0.5], [0.1]], [[0.6], [0.4], [0.2]]
];
List[INT] rising = [1, 1, 1, 0, 0, 0];

GESHA rnn = gesha.create_rnn(4, "tanh", [3, 1], False, 5);
GESHA out = gesha.create_dense(1, "sigmoid", [4], 0.0, 5);
GESHA model = gesha.sequential([rnn, out]);
model.compile("adam", "binary_crossentropy", []);
model.set_lr(0.1);
model.fit(series, rising, 10, 1);

show(model.predict_label(series));
show(model.predict_label([[[0.3], [0.5], [0.8]], [[0.7], [0.4], [0.0]]]));
