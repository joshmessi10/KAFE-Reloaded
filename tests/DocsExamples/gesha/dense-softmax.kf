import gesha;

List[List[FLOAT]] X = [[1.0, 1.0], [1.5, 1.0], [5.0, 1.0], [5.5, 1.5], [3.0, 5.0], [3.5, 5.5]];
List[INT] y = [0, 0, 1, 1, 2, 2];
GESHA out = gesha.create_dense(3, "softmax", [2], 0.0, 3);
GESHA model = gesha.sequential([out]);
model.compile("adam", "sparse_categorical_crossentropy", []);
model.set_lr(0.3);
model.fit(X, y, 10, 1);
show(model.predict_label(X));
show(model.predict_label([[1.2, 1.2], [5.2, 1.2], [3.2, 5.2]]));
