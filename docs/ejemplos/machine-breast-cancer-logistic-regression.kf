-- Logistic Regression: classification with Breast Cancer Wisconsin.
-- Five held-out predictions are printed below.
import kaggle;
import machine;

List[STR] columnas = [
    "radius_mean", "texture_mean", "smoothness_mean",
    "compactness_mean", "concavity_mean", "symmetry_mean"
];
List[List[FLOAT]] X = kaggle.load_dataset_matrix(
    "uciml/breast-cancer-wisconsin-data", columnas, "data.csv", 240
);
PARDOS df = kaggle.load_dataset("uciml/breast-cancer-wisconsin-data", "data.csv");
List[STR] diagnosis = df.col("diagnosis");
List[INT] y = [];
INT i = 0;
while (i < len(X)):
    INT clase = 0;
    if (diagnosis[i] == "M"):
        clase = 1;
    ;
    append(y, clase);
    i = i + 1;
;
MACHINE split = machine.stratified_train_test_split(X, y, 0.2, 42);
List[List[FLOAT]] X_train = split[0];
List[List[FLOAT]] X_test = split[1];
List[INT] y_train = split[2];
List[INT] y_test = split[3];

MACHINE scaler = machine.standard_scaler();
scaler.fit(X_train);
List[List[FLOAT]] train_scaled = scaler.transform(X_train);
List[List[FLOAT]] test_scaled = scaler.transform(X_test);
show("Train/test:");
show([len(X_train), len(X_test)]);

MACHINE logistica = machine.logistic_regression(0.03, 400);
logistica.fit(train_scaled, y_train);
List[INT] pred_logistica = logistica.predict(test_scaled);
show("Logistic Regression - Breast Cancer Wisconsin: accuracy and confusion matrix:");
show(machine.accuracy_score(y_test, pred_logistica));
show(machine.confusion_matrix(y_test, pred_logistica));

List[INT] pred_ejemplos = logistica.predict(test_scaled);
show("Five test cases: expected -> predicted:");
for (j in range(0, 5)):
    show(str(y_test[j]) + " -> " + str(pred_ejemplos[j]));
;
