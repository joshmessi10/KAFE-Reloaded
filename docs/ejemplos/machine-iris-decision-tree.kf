-- Iris Species - Decision Tree: clasificacion supervisada.
-- Dataset: https://www.kaggle.com/datasets/uciml/iris
-- Id es un identificador y no debe entrar en X.
import kaggle;
import machine;
import plot;

List[STR] columnas = ["SepalLengthCm", "SepalWidthCm", "PetalLengthCm", "PetalWidthCm"];
List[List[FLOAT]] X = kaggle.load_dataset_matrix("uciml/iris", columnas, "Iris.csv", 0);
PARDOS df = kaggle.load_dataset("uciml/iris", "Iris.csv");
List[STR] especies = df.col("Species");
List[INT] y = [];
INT i = 0;
while (i < len(especies)):
    INT clase = 0;
    if (especies[i] == "Iris-versicolor"):
        clase = 1;
    ;
    if (especies[i] == "Iris-virginica"):
        clase = 2;
    ;
    append(y, clase);
    i = i + 1;
;

-- Las especies solo intervienen en la parte supervisada.
MACHINE split = machine.stratified_train_test_split(X, y, 0.2, 42);
List[List[FLOAT]] X_train = split[0];
List[List[FLOAT]] X_test = split[1];
List[INT] y_train = split[2];
List[INT] y_test = split[3];
show("Train/test:");
show([len(X_train), len(X_test)]);

MACHINE arbol = machine.decision_tree_classifier("gini", 4, 2, 1);
arbol.fit(X_train, y_train);
List[INT] pred_arbol = arbol.predict(X_test);
show("Decision Tree - Iris Species: accuracy y matriz de confusion:");
show(machine.accuracy_score(y_test, pred_arbol));
show(machine.confusion_matrix(y_test, pred_arbol));

-- Cinco casos de evaluacion tomados del conjunto de prueba.
List[INT] pred_ejemplos = arbol.predict(X_test);
show("Cinco casos de evaluacion: esperado -> predicho:");
for (j in range(0, 5)):
    show(str(y_test[j]) + " -> " + str(pred_ejemplos[j]));
;

-- Comparacion de valores reales y predichos en el conjunto de prueba.
List[FLOAT] indices_plot = [];
for (j in range(0, len(y_test))):
    append(indices_plot, float(j));
;
plot.figure();
plot.title("iris decision tree: prueba");
plot.xlabel("Indice de muestra de prueba");
plot.ylabel("Valor real y predicho");
plot.pointColor("blue");
plot.graph(indices_plot, y_test, "point");
plot.pointColor("orange");
plot.graph(indices_plot, pred_ejemplos, "point");
plot.render();
