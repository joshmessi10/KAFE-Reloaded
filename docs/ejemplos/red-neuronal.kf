-- ============================================
-- Red Neuronal con KafeGESHA
-- Clasificación binaria: problema AND
-- ============================================

import geshaDeep;

show("=== Red Neuronal: Clasificación AND ===");

-- Datos de entrenamiento
List[List[INT]] x_train = [[0,0], [0,1], [1,0], [1,1]];
List[INT] y_train = [0, 0, 0, 1];

-- Crear modelo secuencial con capa densa (1 neurona, sigmoid, 2 entradas)
GESHA layer = geshaDeep.create_dense(1, "sigmoid", [2], 0.0, 42);
GESHA model = geshaDeep.sequential([layer]);

-- Compilar modelo
model.compile("sgd", "binary_crossentropy", []);

-- Entrenar
show("Entrenando...");
model.fit(x_train, y_train, 1000, 1);

-- Evaluar
show("\nResultados:");
for (p in x_train):
    List[FLOAT] prob = model.predict(p);
    INT lbl = model.predict_label(p);
    show(str(p) + " -> prob=" + str(prob[0]) + ", clase=" + str(lbl));
;

-- ============================================
-- Regresión con KafeGESHA
-- ============================================
show("\n=== Red Neuronal: Regresión ===");

-- Datos: y = 2x
List[List[FLOAT]] X = [[1.0], [2.0], [3.0], [4.0]];
List[FLOAT] Y = [2.0, 4.0, 6.0, 8.0];

GESHA reg_layer = geshaDeep.create_dense(1, "linear", [1], 0.0, 42);
GESHA reg_model = geshaDeep.sequential([reg_layer]);

reg_model.compile("sgd", "mse", []);
reg_model.fit(X, Y, 50, 1);

List[FLOAT] pred = reg_model.predict([5.0]);
show("Predicción para x=5.0: " + str(pred[0]));
show("Esperado: ~10.0");
