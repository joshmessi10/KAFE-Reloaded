-- Nivel 8: MNIST 28x28 -> 784 -> 128 -> 64 -> 10.
-- Dataset: https://www.kaggle.com/datasets/scolianni/mnistasjpg
-- Demo pequena: dos imagenes por digito; ampliala para buscar mejor accuracy.
import kaggle;
import machine;
import gesha;

-- El dataset duplica 600 JPEG en la raiz de trainingSample sin etiqueta.
-- El cargador les asigna clase 10; conservamos solo carpetas 0..9.
MACHINE datos = kaggle.load_image_folder_dataset("scolianni/mnistasjpg", 28, 28, "gray", 0, "trainingSample");
List[List[List[List[FLOAT]]]] imagenes = datos[0];
List[INT] etiquetas = datos[1];
List[List[FLOAT]] X = [];
List[INT] y = [];
for (digito in range(0, 10)):
    INT tomados = 0;
    INT i = 0;
    while (i < len(etiquetas)):
        if (etiquetas[i] == digito):
            if (tomados < 2):
                List[FLOAT] pixeles = [];
                for (fila in range(0, 28)):
                    for (columna in range(0, 28)):
                        append(pixeles, imagenes[i][0][fila][columna]);
                    ;
                ;
                append(X, pixeles);
                append(y, digito);
                tomados = tomados + 1;
            ;
        ;
        i = i + 1;
    ;
;
show("Imagenes etiquetadas seleccionadas:");
show(len(X));
MACHINE division = machine.stratified_train_test_split(X, y, 0.5, 42);
List[List[FLOAT]] X_train = division[0];
List[List[FLOAT]] X_test = division[1];
List[INT] y_train = division[2];
List[INT] y_test = division[3];

GESHA h1 = gesha.create_dense(128, "relu", [784], 0.0, 42, gesha.he_normal(42));
GESHA h2 = gesha.create_dense(64, "relu", [128], 0.0, 43, gesha.he_normal(43));
GESHA salida = gesha.create_dense(10, "softmax", [64], 0.0, 44, gesha.glorot_uniform(44));
GESHA modelo = gesha.sequential([h1, h2, salida]);
modelo.compile("adam", "sparse_categorical_crossentropy", []);
modelo.set_lr(0.01);
modelo.fit(X_train, y_train, 4, 2);

List[INT] predicciones = modelo.predict_label(X_test);
INT aciertos = 0;
for (i in range(0, len(y_test))):
    if (predicciones[i] == y_test[i]):
        aciertos = aciertos + 1;
    ;
    show("Digito real=" + str(y_test[i]) + " predicho=" + str(predicciones[i]));
;
show("MNIST accuracy test (muestra didactica):");
show(aciertos / len(y_test));
