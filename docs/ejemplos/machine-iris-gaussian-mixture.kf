-- Iris Species - Gaussian Mixture: clustering sin etiquetas.
-- Dataset: https://www.kaggle.com/datasets/uciml/iris
-- Id es un identificador y no debe entrar en X.
import kaggle;
import machine;
import plot;

-- GMM descubre grupos sin usar Species. Dos petalos ayudan a visualizar.
List[List[FLOAT]] petalos = kaggle.load_dataset_matrix(
    "uciml/iris", ["PetalLengthCm", "PetalWidthCm"], "Iris.csv", 0
);
MACHINE gmm = machine.gaussian_mixture(3, 50, 0.001, 42);
gmm.fit(petalos);
List[INT] grupos = gmm.predict(petalos);
show("Gaussian Mixture - Iris Species: muestras y primera etiqueta arbitraria:");
show(len(grupos));
show(grupos[0]);
show("Silhouette Gaussian Mixture - Iris Species:");
show(machine.silhouette_score(petalos, grupos));

-- En clustering, estas son asignaciones de muestras vistas durante fit.
-- Cinco casos de evaluacion (sin etiqueta supervisada).
show("Cinco casos de evaluacion: caracteristicas, grupo asignado:");
List[INT] casos = [0, 37, 75, 112, 149];
for (indice in casos):
    show(str(petalos[indice]) + " -> " + str(grupos[indice]));
;

-- Distribucion espacial de los grupos Gaussianos.
plot.figure();
plot.title("iris gaussian mixture: grupos");
plot.xlabel("Variable 1");
plot.ylabel("Variable 2");
List[STR] colores = ["gray", "blue", "red", "green", "orange", "purple", "brown", "black"];
for (grupo in range(-1, 3)):
    List[FLOAT] xs_grupo = [];
    List[FLOAT] ys_grupo = [];
    for (j in range(0, len(petalos))):
        if (grupos[j] == grupo):
            append(xs_grupo, petalos[j][0]);
            append(ys_grupo, petalos[j][1]);
        ;
    ;
    if (len(xs_grupo) > 0):
        plot.pointColor(colores[grupo + 1]);
        plot.graph(xs_grupo, ys_grupo, "point");
    ;
;
plot.render();
