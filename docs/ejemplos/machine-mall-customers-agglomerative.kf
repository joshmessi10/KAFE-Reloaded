-- Mall Customers - Agglomerative Clustering: segmentacion sin etiquetas.
-- Dataset: https://www.kaggle.com/datasets/vjchoudhary7/customer-segmentation-tutorial-in-python
-- CustomerID es un identificador; Gender requiere codificacion y no se usa.
-- No hay train/test: estas tecnicas descriptivas no predicen una etiqueta externa.
import kaggle;
import machine;
import plot;

List[STR] columnas = ["Annual Income (k$)", "Spending Score (1-100)"];
List[List[FLOAT]] X = kaggle.load_dataset_matrix(
    "vjchoudhary7/customer-segmentation-tutorial-in-python",
    columnas, "Mall_Customers.csv", 0
);
MACHINE scaler = machine.standard_scaler();
scaler.fit(X);
List[List[FLOAT]] X_scaled = scaler.transform(X);
show("Clientes:");
show(len(X_scaled));

MACHINE aglomerativo = machine.agglomerative_clustering(5, "ward");
List[INT] grupos_jerarquicos = aglomerativo.fit_predict(X_scaled);
show("Agglomerative Clustering - Mall Customers: primera etiqueta:");
show(grupos_jerarquicos[0]);
show("Silhouette Agglomerative Clustering - Mall Customers:");
show(machine.silhouette_score(X_scaled, grupos_jerarquicos));

-- En clustering, estas son asignaciones de muestras vistas durante fit.
-- Cinco casos de evaluacion (sin etiqueta supervisada).
show("Cinco casos de evaluacion: caracteristicas, grupo asignado:");
List[INT] casos = [0, 49, 99, 149, 199];
for (indice in casos):
    show(str(X_scaled[indice]) + " -> " + str(grupos_jerarquicos[indice]));
;

-- Distribucion espacial de los grupos jerarquicos.
plot.figure();
plot.title("mall customers agglomerative: grupos");
plot.xlabel("Variable 1");
plot.ylabel("Variable 2");
List[STR] colores = ["gray", "blue", "red", "green", "orange", "purple", "brown", "black"];
for (grupo in range(-1, 6)):
    List[FLOAT] xs_grupo = [];
    List[FLOAT] ys_grupo = [];
    for (j in range(0, len(X_scaled))):
        if (grupos_jerarquicos[j] == grupo):
            append(xs_grupo, X_scaled[j][0]);
            append(ys_grupo, X_scaled[j][1]);
        ;
    ;
    if (len(xs_grupo) > 0):
        plot.pointColor(colores[grupo + 1]);
        plot.graph(xs_grupo, ys_grupo, "point");
    ;
;
plot.render();
