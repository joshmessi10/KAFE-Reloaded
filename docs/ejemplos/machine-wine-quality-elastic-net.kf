-- Red Wine Quality - Elastic Net: regresion de quality.
-- Dataset: https://www.kaggle.com/datasets/uciml/red-wine-quality-cortez-et-al-2009
-- quality es un puntaje ordinal; aqui se trata como regresion numerica.
import kaggle;
import machine;
import plot;

List[STR] columnas = [
    "fixed acidity", "volatile acidity", "citric acid", "residual sugar",
    "chlorides", "density", "pH", "sulphates", "alcohol"
];
List[List[FLOAT]] X = kaggle.load_dataset_matrix(
    "uciml/red-wine-quality-cortez-et-al-2009", columnas, "winequality-red.csv", 320
);
PARDOS df = kaggle.load_dataset(
    "uciml/red-wine-quality-cortez-et-al-2009", "winequality-red.csv"
);
List[INT] calidad = df.col("quality");
List[FLOAT] y = [];
INT i = 0;
while (i < len(X)):
    append(y, float(calidad[i]));
    i = i + 1;
;
MACHINE split = machine.train_test_split(X, y, 0.2, 42);
List[List[FLOAT]] X_train = split[0];
List[List[FLOAT]] X_test = split[1];
List[FLOAT] y_train = split[2];
List[FLOAT] y_test = split[3];
MACHINE scaler = machine.standard_scaler();
scaler.fit(X_train);
List[List[FLOAT]] train_scaled = scaler.transform(X_train);
List[List[FLOAT]] test_scaled = scaler.transform(X_test);
show("Train/test:");
show([len(X_train), len(X_test)]);

MACHINE elastic = machine.elastic_net(0.05, 0.5, True, 1000);
elastic.fit(train_scaled, y_train);
List[FLOAT] pred_elastic = elastic.predict(test_scaled);
show("Elastic Net - Red Wine Quality: MAE y R2:");
show(machine.mean_absolute_error(y_test, pred_elastic));
show(machine.r2_score(y_test, pred_elastic));

-- Cinco casos de evaluacion tomados del conjunto de prueba.
List[FLOAT] pred_ejemplos = elastic.predict(test_scaled);
show("Cinco casos de evaluacion: esperado -> predicho:");
for (j in range(0, 5)):
    show(str(y_test[j]) + " -> " + str(pred_ejemplos[j]));
;

-- Comparacion de valores reales y predichos en el conjunto de prueba.
List[FLOAT] indices_plot = [];
for (j in range(0, len(y_test))):
    append(indices_plot, float(j));
;
plot.figure();
plot.title("wine quality elastic net: prueba");
plot.xlabel("Indice de muestra de prueba");
plot.ylabel("Valor real y predicho");
plot.pointColor("blue");
plot.graph(indices_plot, y_test, "point");
plot.pointColor("orange");
plot.graph(indices_plot, pred_ejemplos, "point");
plot.render();
