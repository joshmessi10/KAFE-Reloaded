-- Linear Discriminant Analysis: classification with Iris Species.
-- Five held-out predictions are printed below.
import kaggle;
import machine;

List[STR] columnas = ["SepalLengthCm", "SepalWidthCm", "PetalLengthCm", "PetalWidthCm"];
List[List[FLOAT]] X = kaggle.load_dataset_matrix("uciml/iris", columnas, "Iris.csv", 0);
PARDOS df = kaggle.load_dataset("uciml/iris", "Iris.csv");
List[STR] especies = df.col("Species");
List[INT] y = [];
INT i = 0;
while (i < len(especies)):
    INT clase = 0;
    if (especies[i] == "Iris-versicolor"):
        clase = 1;
    ;
    if (especies[i] == "Iris-virginica"):
        clase = 2;
    ;
    append(y, clase);
    i = i + 1;
;

MACHINE split = machine.stratified_train_test_split(X, y, 0.2, 42);
List[List[FLOAT]] X_train = split[0];
List[List[FLOAT]] X_test = split[1];
List[INT] y_train = split[2];
List[INT] y_test = split[3];
MACHINE scaler = machine.standard_scaler();
scaler.fit(X_train);
List[List[FLOAT]] train_scaled = scaler.transform(X_train);
List[List[FLOAT]] test_scaled = scaler.transform(X_test);
show("Train/test:");
show([len(X_train), len(X_test)]);

MACHINE lda = machine.linear_discriminant_analysis(2);
lda.fit(train_scaled, y_train);
List[INT] pred_lda = lda.predict(test_scaled);
show("Linear Discriminant Analysis - Iris Species: accuracy:");
show(machine.accuracy_score(y_test, pred_lda));
show("Linear Discriminant Analysis - Iris Species: two components:");
List[List[FLOAT]] componentes = lda.transform(test_scaled);
show(componentes[0]);

List[INT] pred_ejemplos = lda.predict(test_scaled);
show("Five test cases: expected -> predicted:");
for (j in range(0, 5)):
    show(str(y_test[j]) + " -> " + str(pred_ejemplos[j]));
;
