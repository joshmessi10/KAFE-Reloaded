-- Multiclass MLP: Iris: multiclass classification with Iris Species.
import kaggle;
import machine;
import gesha;

List[STR] columns = ["SepalLengthCm", "SepalWidthCm", "PetalLengthCm", "PetalWidthCm"];
List[List[FLOAT]] X = kaggle.load_dataset_matrix("uciml/iris", columns, "Iris.csv", 0);
PARDOS df = kaggle.load_dataset("uciml/iris", "Iris.csv");
List[STR] species = df.col("Species");
List[INT] y = [];
for (i in range(0, len(X))):
    INT class_label = 0;
    if (species[i] == "Iris-versicolor"):
        class_label = 1;
    ;
    if (species[i] == "Iris-virginica"):
        class_label = 2;
    ;
    append(y, class_label);
;
MACHINE split = machine.stratified_train_test_split(X, y, 0.2, 42);
List[List[FLOAT]] X_train = split[0];
List[List[FLOAT]] X_test = split[1];
List[INT] y_train = split[2];
List[INT] y_test = split[3];
MACHINE scaler = machine.standard_scaler();
scaler.fit(X_train);
List[List[FLOAT]] train_scaled = scaler.transform(X_train);
List[List[FLOAT]] test_scaled = scaler.transform(X_test);

GESHA hidden_layer = gesha.create_dense(8, "relu", [4], 0.0, 42, gesha.he_normal(42));
GESHA output_layer = gesha.create_dense(3, "softmax", [8], 0.0, 43, gesha.glorot_uniform(43));
GESHA model = gesha.sequential([hidden_layer, output_layer]);
model.compile("adam", "sparse_categorical_crossentropy", []);
model.set_lr(0.01);
model.fit(train_scaled, y_train, 80, 16);

List[INT] predictions = model.predict_label(test_scaled);
INT correct = 0;
for (i in range(0, len(y_test))):
    if (predictions[i] == y_test[i]):
        correct = correct + 1;
    ;
    if (i < 5):
        show("Iris actual=" + str(y_test[i]) + " predicted=" + str(predictions[i]));
    ;
;
show("Iris accuracy test:");
show(correct / len(y_test));
