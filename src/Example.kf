import pardos;
import geshaDeep;
import plot;

show("=== Optimized Unsupervised Clustering ===");

-- 1. Preprocessing with KafePARDOS
PARDOS df = pardos.read_csv("../tests/data/clustering_sample.csv");
List[List[FLOAT]] X_train = pardos.to_matrix(df);

-- 2. Define the sequential model
GESHA layer1 = geshaDeep.create_dense(8, "relu", [2], 0.0, 42);
GESHA layer2 = geshaDeep.create_dense(2, "softmax", [], 0.0, 42);
GESHA model  = geshaDeep.sequential([layer1, layer2]);

model.compile("adam", "mse", []);

-- Increase the learning rate to accelerate convergence
geshaDeep.set_lr(model, 0.01);

-- 3. Unsupervised training (100 epochs)
show("\nTraining...");
model.fit(X_train, [], 100, 1);

-- 4. Cluster inference
List[FLOAT] c0_x = []; List[FLOAT] c0_y = [];
List[FLOAT] c1_x = []; List[FLOAT] c1_y = [];

show("\nResults by point:");
for (p in X_train):
    INT cluster_id = model.predict_label(p);
    List[FLOAT] probs = model.predict(p);
    show("Point " + str(p) + " -> Cluster " + str(cluster_id) + " (Probabilities: " + str(probs) + ")");

    if (cluster_id == 0):
        append(c0_x, p[0]);
        append(c0_y, p[1]);
    else:
        append(c1_x, p[0]);
        append(c1_y, p[1]);
    ;
;

-- 5. Plot with KafePlot
plot.figure();
plot.title("Data Clustering — KafeGESHA + KafePlot");
plot.xlabel("X1");
plot.ylabel("X2");
plot.grid(True);

if (len(c0_x) > 0):
    plot.color("blue");
    plot.pointColor("blue");
    plot.pointSize(7);
    plot.graph(c0_x, c0_y, "point");
;

if (len(c1_x) > 0):
    plot.color("red");
    plot.pointColor("red");
    plot.pointSize(7);
    plot.graph(c1_x, c1_y, "point");
;

plot.render();
show("SVG chart generated successfully.");
