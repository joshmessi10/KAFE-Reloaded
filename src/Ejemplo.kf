import pardos;
import geshaDeep;
import plot;

show("=== Clustering No Supervisado Optimizado ===");

-- 1. Preprocesamiento con KafePARDOS
PARDOS df = pardos.read_csv("../tests/data/clustering_sample.csv");
List[List[FLOAT]] X_train = pardos.to_matrix(df);

-- 2. Definición del Modelo Secuencial
GESHA layer1 = geshaDeep.create_dense(8, "relu", [2], 0.0, 42);
GESHA layer2 = geshaDeep.create_dense(2, "softmax", [], 0.0, 42);
GESHA model  = geshaDeep.sequential([layer1, layer2]);

model.compile("adam", "mse", []);

-- Aumentar la tasa de aprendizaje para acelerar la convergencia
geshaDeep.set_lr(model, 0.01);

-- 3. Entrenamiento No Supervisado (100 épocas)
show("\nEntrenando...");
model.fit(X_train, [], 100, 1);

-- 4. Inferencia de Clusters
List[FLOAT] c0_x = []; List[FLOAT] c0_y = [];
List[FLOAT] c1_x = []; List[FLOAT] c1_y = [];

show("\nResultados por Punto:");
for (p in X_train):
    INT cluster_id = model.predict_label(p);
    List[FLOAT] probs = model.predict(p);
    show("Punto " + str(p) + " -> Cluster " + str(cluster_id) + " (Probabilidades: " + str(probs) + ")");

    if (cluster_id == 0):
        append(c0_x, p[0]);
        append(c0_y, p[1]);
    else:
        append(c1_x, p[0]);
        append(c1_y, p[1]);
    ;
;

-- 5. Graficación con KafePlot
plot.figure();
plot.title("Clustering de Datos — KafeGESHA + KafePlot");
plot.xlabel("X1");
plot.ylabel("X2");
plot.grid(True);

if (len(c0_x) > 0):
    plot.color("blue");
    plot.pointColor("blue");
    plot.pointSize(7);
    plot.graph(c0_x, c0_y, "point");
;

if (len(c1_x) > 0):
    plot.color("red");
    plot.pointColor("red");
    plot.pointSize(7);
    plot.graph(c1_x, c1_y, "point");
;

plot.render();
show("Gráfico SVG generado con éxito.");
