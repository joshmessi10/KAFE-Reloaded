import machine;

-- Decision tree classifier: Basic example
-- Binary classification with two features

List[List[FLOAT]] X = [[1.0, 2.0], [2.0, 3.0], [3.0, 3.0],
                        [6.0, 5.0], [7.0, 7.0], [8.0, 6.0]];
List[INT] y = [0, 0, 0, 1, 1, 1];

-- Create a model with the default Gini criterion
MACHINE model = machine.decision_tree_classifier();
model.fit(X, y);

-- Predict
List[INT] preds = model.predict([[1.0, 2.0], [7.0, 7.0], [4.0, 4.0]]);
show("Predictions:");
show(preds);

-- Accuracy
FLOAT acc = model.score(X, y);
show("Accuracy:");
show(acc);

-- Use entropy and limit max_depth
MACHINE model2 = machine.decision_tree_classifier("entropy", 2);
model2.fit(X, y);
show("Predictions (entropy, depth=2):");
show(model2.predict([[1.0, 2.0], [7.0, 7.0]]));
