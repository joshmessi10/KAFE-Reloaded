                <mxCell id="tutorflow_send" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=10;spacingTop=8;spacingBottom=7;fontFamily=Arial;fontSize=12;fontColor=#172B4D;fillColor=#EAF2FF;strokeColor=#4776A8;strokeWidth=1.5;shadow=1;" value="&lt;div style=&quot;font-family:Arial;font-size:13px;font-weight:700;color:#172B4D;&quot;&gt;4. Explicit Send&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;color:#26323A;margin-top:4px;&quot;&gt;UI sends unchanged draft and current preview token. Editing or source changes invalidate the token.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="135" width="260" x="50" y="765" as="geometry"/>
                </mxCell>
                <mxCell id="tutorflow_view" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=10;spacingTop=8;spacingBottom=7;fontFamily=Arial;fontSize=12;fontColor=#172B4D;fillColor=#EAF2FF;strokeColor=#4776A8;strokeWidth=1.5;shadow=1;" value="&lt;div style=&quot;font-family:Arial;font-size:13px;font-weight:700;color:#172B4D;&quot;&gt;TutorViewProvider&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;color:#26323A;margin-top:4px;&quot;&gt;Validates message type, dispatches to coordinator, posts updated state to webview.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="125" width="295" x="365" y="335" as="geometry"/>
                </mxCell>
                <mxCell id="tutorflow_coordinator" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=10;spacingTop=8;spacingBottom=7;fontFamily=Arial;fontSize=12;fontColor=#38245A;fillColor=#F2EAFE;strokeColor=#8056B3;strokeWidth=1.5;shadow=1;" value="&lt;div style=&quot;font-family:Arial;font-size:13px;font-weight:700;color:#38245A;&quot;&gt;SessionCoordinator&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;color:#26323A;margin-top:4px;&quot;&gt;Owns state, preview revision/token, send gate, tool loop, stale-turn checks, retry and response feedback.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="180" width="295" x="365" y="535" as="geometry"/>
                </mxCell>
                <mxCell id="tutorflow_progressStore" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=10;spacingTop=8;spacingBottom=7;fontFamily=Arial;fontSize=12;fontColor=#56390C;fillColor=#FFF4DF;strokeColor=#BA7A19;strokeWidth=1.5;shadow=1;" value="&lt;div style=&quot;font-family:Arial;font-size:13px;font-weight:700;color:#56390C;&quot;&gt;ProgressStore&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;color:#26323A;margin-top:4px;&quot;&gt;Writes validated learning summary and reviewed checks to workspaceState.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="125" width="295" x="365" y="830" as="geometry"/>
                </mxCell>
                <mxCell id="tutorflow_inputs" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=10;spacingTop=8;spacingBottom=7;fontFamily=Arial;fontSize=12;fontColor=#38245A;fillColor=#F2EAFE;strokeColor=#8056B3;strokeWidth=1.5;shadow=1;" value="&lt;div style=&quot;font-family:Arial;font-size:13px;font-weight:700;color:#38245A;&quot;&gt;Context inputs&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;color:#26323A;margin-top:4px;&quot;&gt;System coaching policy; confirmed goal/milestones; active .kf; latest Run only when it matches that file; visible same-workspace .kf candidates with optional inclusion.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="165" width="310" x="715" y="150" as="geometry"/>
                </mxCell>
                <mxCell id="tutorflow_composer" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=10;spacingTop=8;spacingBottom=7;fontFamily=Arial;fontSize=12;fontColor=#38245A;fillColor=#F2EAFE;strokeColor=#8056B3;strokeWidth=1.5;shadow=1;" value="&lt;div style=&quot;font-family:Arial;font-size:13px;font-weight:700;color:#38245A;&quot;&gt;ContextComposer&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;color:#26323A;margin-top:4px;&quot;&gt;Validates source URIs and sizes; emits source-tagged messages and exact payload/source list.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="145" width="310" x="715" y="360" as="geometry"/>
                </mxCell>
                <mxCell id="tutorflow_retriever" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=10;spacingTop=8;spacingBottom=7;fontFamily=Arial;fontSize=12;fontColor=#173D26;fillColor=#E8F6ED;strokeColor=#43845D;strokeWidth=1.5;shadow=1;" value="&lt;div style=&quot;font-family:Arial;font-size:13px;font-weight:700;color:#173D26;&quot;&gt;KnowledgeRetriever&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;color:#26323A;margin-top:4px;&quot;&gt;Searches local version-matched KAFE knowledge; composer includes returned passages in preview.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="145" width="310" x="715" y="575" as="geometry"/>
                </mxCell>
                <mxCell id="tutorflow_knowledgeStop" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=10;spacingTop=8;spacingBottom=7;fontFamily=Arial;fontSize=12;fontColor=#493B12;fillColor=#FFF9D9;strokeColor=#C79A27;strokeWidth=1.5;shadow=1;shape=note;size=16;" value="&lt;div style=&quot;font-family:Arial;font-size:13px;font-weight:700;color:#493B12;&quot;&gt;Novel knowledge is a consent boundary&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;color:#26323A;margin-top:4px;&quot;&gt;A passage absent from the reviewed payload is added to a new preview/token. Processing stops before another provider call.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="155" width="310" x="715" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="tutorflow_provider" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=10;spacingTop=8;spacingBottom=7;fontFamily=Arial;fontSize=12;fontColor=#542222;fillColor=#FCEAEA;strokeColor=#B94D4D;strokeWidth=1.5;shadow=1;" value="&lt;div style=&quot;font-family:Arial;font-size:13px;font-weight:700;color:#542222;&quot;&gt;DeepSeekProvider&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;color:#26323A;margin-top:4px;&quot;&gt;Reads key from SecretStorage; sends HTTPS request with tools; validates response; enforces timeout and abort.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="155" width="325" x="1080" y="155" as="geometry"/>
                </mxCell>
                <mxCell id="tutorflow_toolRouter" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=10;spacingTop=8;spacingBottom=7;fontFamily=Arial;fontSize=12;fontColor=#38245A;fillColor=#F2EAFE;strokeColor=#8056B3;strokeWidth=1.5;shadow=1;" value="&lt;div style=&quot;font-family:Arial;font-size:13px;font-weight:700;color:#38245A;&quot;&gt;ToolRouter&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;color:#26323A;margin-top:4px;&quot;&gt;Checks tool name/arguments, source IDs, URI, document version/size, and Run-result shape before dispatch.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="160" width="325" x="1080" y="390" as="geometry"/>
                </mxCell>
                <mxCell id="tutorflow_toolSet" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=10;spacingTop=8;spacingBottom=7;fontFamily=Arial;fontSize=12;fontColor=#38245A;fillColor=#F2EAFE;strokeColor=#8056B3;strokeWidth=1.5;shadow=1;" value="&lt;div style=&quot;font-family:Arial;font-size:13px;font-weight:700;color:#38245A;&quot;&gt;Allowlisted tools and loop limits&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;color:#26323A;margin-top:4px;&quot;&gt;readActiveDocument&lt;br/&gt;searchKafeKnowledge&lt;br/&gt;getLatestRunResult&lt;br/&gt;proposeCodeChange&lt;br/&gt;At most 4 calls per response and 4 provider rounds.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="180" width="325" x="1080" y="625" as="geometry"/>
                </mxCell>
                <mxCell id="tutorflow_final" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=10;spacingTop=8;spacingBottom=7;fontFamily=Arial;fontSize=12;fontColor=#173D26;fillColor=#E8F6ED;strokeColor=#43845D;strokeWidth=1.5;shadow=1;" value="&lt;div style=&quot;font-family:Arial;font-size:13px;font-weight:700;color:#173D26;&quot;&gt;Final tutor response&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;color:#26323A;margin-top:4px;&quot;&gt;Coaching text or proposal-ready result returns through the view provider.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="110" width="325" x="1080" y="890" as="geometry"/>
                </mxCell>
                <mxCell id="tutorflow_workspaceState" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=10;spacingTop=8;spacingBottom=7;fontFamily=Arial;fontSize=12;fontColor=#56390C;fillColor=#FFF4DF;strokeColor=#BA7A19;strokeWidth=1.5;shadow=1;" value="&lt;div style=&quot;font-family:Arial;font-size:13px;font-weight:700;color:#56390C;&quot;&gt;Saved learning summary&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;color:#26323A;margin-top:4px;&quot;&gt;Confirmed goal and milestones; reviewed-check metadata. Conversation messages are not saved.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="120" width="420" x="1460" y="150" as="geometry"/>
                </mxCell>
                <mxCell id="tutorflow_outcome" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=10;spacingTop=8;spacingBottom=7;fontFamily=Arial;fontSize=12;fontColor=#173D26;fillColor=#E8F6ED;strokeColor=#43845D;strokeWidth=1.5;shadow=1;" value="&lt;div style=&quot;font-family:Arial;font-size:13px;font-weight:700;color:#173D26;&quot;&gt;Response outcomes&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;color:#26323A;margin-top:4px;&quot;&gt;Coaching appends learner/tutor messages; provider errors offer retry of reviewed payload; unexpected errors refresh preview and keep the draft.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="150" width="420" x="1460" y="350" as="geometry"/>
                </mxCell>
                <mxCell id="tutorflow_proposalDiff" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=10;spacingTop=8;spacingBottom=7;fontFamily=Arial;fontSize=12;fontColor=#38245A;fillColor=#F2EAFE;strokeColor=#8056B3;strokeWidth=1.5;shadow=1;" value="&lt;div style=&quot;font-family:Arial;font-size:13px;font-weight:700;color:#38245A;&quot;&gt;Code proposal review&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;color:#26323A;margin-top:4px;&quot;&gt;CodeProposalProvider stages virtual content and opens VS Code native diff. No automatic execution or edit.&lt;/div&gt;" vertex="1">
