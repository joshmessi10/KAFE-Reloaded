    <diagram id="tutorflow" name="2 - Tutor and Context Flow">
        <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1930" pageHeight="1190" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="tutorflow_title" value="&lt;div style=&quot;font-family:Arial;font-size:23px;font-weight:700;color:#18324B;&quot;&gt;Tutor Session, Context Consent, and Tool Flow&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:12px;color:#52616B;&quot;&gt;Preview is local. The provider receives the exact reviewed payload only after explicit Send with a matching draft and preview token.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1">
