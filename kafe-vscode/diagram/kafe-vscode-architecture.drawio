                <mxCell id="tutorflow_preview" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=10;spacingTop=8;spacingBottom=7;fontFamily=Arial;fontSize=12;fontColor=#172B4D;fillColor=#EAF2FF;strokeColor=#4776A8;strokeWidth=1.5;shadow=1;" value="&lt;div style=&quot;font-family:Arial;font-size:13px;font-weight:700;color:#172B4D;&quot;&gt;3. Inspect exact request preview&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;color:#26323A;margin-top:4px;&quot;&gt;Shows payload and Included / Excluded source rows. Optional visible .kf files can be excluded.&lt;/div&gt;" vertex="1">
