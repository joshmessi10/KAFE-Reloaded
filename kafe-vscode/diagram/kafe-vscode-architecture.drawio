                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="tutorflow_e17" value="tool result" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#8251A4;strokeWidth=1.5;fontFamily=Arial;fontSize=11;fontColor=#26323A;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="tutorflow_toolRouter" target="tutorflow_coordinator">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="tutorflow_e18" value="new passage check" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#B84747;strokeWidth=1.5;fontFamily=Arial;fontSize=11;fontColor=#26323A;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="tutorflow_retriever" target="tutorflow_knowledgeStop">
