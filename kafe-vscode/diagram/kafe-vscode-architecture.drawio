                <mxCell id="runtime_runner" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=10;spacingTop=8;spacingBottom=7;fontFamily=Arial;fontSize=12;fontColor=#173D26;fillColor=#E8F6ED;strokeColor=#43845D;strokeWidth=1.5;shadow=1;" value="&lt;div style=&quot;font-family:Arial;font-size:13px;font-weight:700;color:#173D26;&quot;&gt;kafeRunner.js&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;color:#26323A;margin-top:4px;&quot;&gt;Spawns without a shell; passes interactive stdin; streams output; cancel sends SIGTERM.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="165" width="225" x="1645" y="155" as="geometry"/>
                </mxCell>
                <mxCell id="runtime_terminalProcess" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=10;spacingTop=8;spacingBottom=7;fontFamily=Arial;fontSize=12;fontColor=#172B4D;fillColor=#EAF2FF;strokeColor=#4776A8;strokeWidth=1.5;shadow=1;" value="&lt;div style=&quot;font-family:Arial;font-size:13px;font-weight:700;color:#172B4D;&quot;&gt;VS Code pseudoterminal&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;color:#26323A;margin-top:4px;&quot;&gt;Shows live stdout/stderr and accepts learner input while KAFE.py runs.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="160" width="220" x="1400" y="390" as="geometry"/>
                </mxCell>
                <mxCell id="runtime_evidence" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=10;spacingTop=8;spacingBottom=7;fontFamily=Arial;fontSize=12;fontColor=#38245A;fillColor=#F2EAFE;strokeColor=#8056B3;strokeWidth=1.5;shadow=1;" value="&lt;div style=&quot;font-family:Arial;font-size:13px;font-weight:700;color:#38245A;&quot;&gt;Run evidence&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;color:#26323A;margin-top:4px;&quot;&gt;Retains stdout/stderr up to 1 MiB total; records truncation, exit code, source URI, sequence, mode and versions.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="180" width="225" x="1645" y="390" as="geometry"/>
                </mxCell>
                <mxCell id="runtime_evidenceHost" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=10;spacingTop=8;spacingBottom=7;fontFamily=Arial;fontSize=12;fontColor=#38245A;fillColor=#F2EAFE;strokeColor=#8056B3;strokeWidth=1.5;shadow=1;" value="&lt;div style=&quot;font-family:Arial;font-size:13px;font-weight:700;color:#38245A;&quot;&gt;SessionCoordinator&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;color:#26323A;margin-top:4px;&quot;&gt;Accepts validated, increasing Run sequences; associates evidence with source.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="155" width="220" x="1400" y="625" as="geometry"/>
                </mxCell>
                <mxCell id="runtime_reviewCheck" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=10;spacingTop=8;spacingBottom=7;fontFamily=Arial;fontSize=12;fontColor=#56390C;fillColor=#FFF4DF;strokeColor=#BA7A19;strokeWidth=1.5;shadow=1;" value="&lt;div style=&quot;font-family:Arial;font-size:13px;font-weight:700;color:#56390C;&quot;&gt;Learner-reviewed check&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;color:#26323A;margin-top:4px;&quot;&gt;Optional label/outcome linked to a Run; saved to workspaceState. Passing run alone does not prove mastery.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="155" width="225" x="1645" y="625" as="geometry"/>
                </mxCell>
                <mxCell id="runtime_devPack" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=10;spacingTop=8;spacingBottom=7;fontFamily=Arial;fontSize=12;fontColor=#173D26;fillColor=#E8F6ED;strokeColor=#43845D;strokeWidth=1.5;shadow=1;" value="&lt;div style=&quot;font-family:Arial;font-size:13px;font-weight:700;color:#173D26;&quot;&gt;DevelopmentKnowledgePack&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;color:#26323A;margin-top:4px;&quot;&gt;Development extension only. Requires marker files pyproject.toml, uv.lock, src/Kafe.py. Packages six curated docs sections plus src grammar; hashes and caches the pack.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="205" width="300" x="50" y="950" as="geometry"/>
                </mxCell>
                <mxCell id="runtime_managedPack" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=10;spacingTop=8;spacingBottom=7;fontFamily=Arial;fontSize=12;fontColor=#173D26;fillColor=#E8F6ED;strokeColor=#43845D;strokeWidth=1.5;shadow=1;" value="&lt;div style=&quot;font-family:Arial;font-size:13px;font-weight:700;color:#173D26;&quot;&gt;Managed knowledge pack&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;color:#26323A;margin-top:4px;&quot;&gt;Shipped in verified runtime archive; runtime and knowledge versions must match. Preferred when managed runtime is ready.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="205" width="300" x="420" y="950" as="geometry"/>
