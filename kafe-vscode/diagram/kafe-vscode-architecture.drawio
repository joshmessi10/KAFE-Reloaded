                <mxCell id="tutorflow_e15" value="allowlisted operation" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#288052;strokeWidth=1.5;fontFamily=Arial;fontSize=11;fontColor=#26323A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tutorflow_toolRouter" target="tutorflow_toolSet">
