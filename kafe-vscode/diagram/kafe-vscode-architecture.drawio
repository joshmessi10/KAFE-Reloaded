                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="tutorflow_e9" value="exact payload + source list" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#8251A4;strokeWidth=1.5;fontFamily=Arial;fontSize=11;fontColor=#26323A;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="tutorflow_composer" target="tutorflow_preview">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="tutorflow_e10" value="review, then send" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#355F91;strokeWidth=1.5;fontFamily=Arial;fontSize=11;fontColor=#26323A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tutorflow_preview" target="tutorflow_send">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="tutorflow_e11" value="draft + previewToken" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#355F91;strokeWidth=1.5;fontFamily=Arial;fontSize=11;fontColor=#26323A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tutorflow_send" target="tutorflow_coordinator">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="tutorflow_e12" value="matching reviewed payload only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#BB7412;strokeWidth=1.5;fontFamily=Arial;fontSize=11;fontColor=#26323A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tutorflow_coordinator" target="tutorflow_provider">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
