                </mxCell>
                <mxCell id="tutorflow_e19" value="new preview; stop provider loop" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#B84747;strokeWidth=1.5;fontFamily=Arial;fontSize=11;fontColor=#26323A;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="tutorflow_knowledgeStop" target="tutorflow_composer">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="tutorflow_e20" value="accepted final turn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#8251A4;strokeWidth=1.5;fontFamily=Arial;fontSize=11;fontColor=#26323A;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="tutorflow_coordinator" target="tutorflow_final">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="tutorflow_e21" value="render conversation / status" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#8251A4;strokeWidth=1.5;fontFamily=Arial;fontSize=11;fontColor=#26323A;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="tutorflow_final" target="tutorflow_outcome">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="tutorflow_e22" value="proposeCodeChange result" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#355F91;strokeWidth=1.5;fontFamily=Arial;fontSize=11;fontColor=#26323A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tutorflow_toolRouter" target="tutorflow_proposalDiff">
                    <mxGeometry relative="1" as="geometry"/>
