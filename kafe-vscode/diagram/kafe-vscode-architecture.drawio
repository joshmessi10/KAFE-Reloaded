                <mxCell id="runtime_invocation" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=10;spacingTop=8;spacingBottom=7;fontFamily=Arial;fontSize=12;fontColor=#173D26;fillColor=#E8F6ED;strokeColor=#43845D;strokeWidth=1.5;shadow=1;" value="&lt;div style=&quot;font-family:Arial;font-size:13px;font-weight:700;color:#173D26;&quot;&gt;Run invocation&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;color:#26323A;margin-top:4px;&quot;&gt;uv run --locked python src/Kafe.py &amp;lt;file&amp;gt;&lt;br/&gt;Managed mode adds --no-dev.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="165" width="220" x="1400" y="155" as="geometry"/>
