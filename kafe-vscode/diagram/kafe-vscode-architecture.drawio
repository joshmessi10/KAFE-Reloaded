                <mxCell id="tutorflow_effects_label" value="&lt;div style=&quot;font-family:Arial;font-size:14px;font-weight:700;color:#BA7A19;&quot;&gt;Persistence and review effects&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontStyle=1;fontColor=#BA7A19;strokeColor=none;fillColor=none;" vertex="1" parent="1">
