                <mxCell id="runtime_stage" value="&lt;div style=&quot;font-family:Arial;font-size:13px;font-weight:700;color:#56390C;&quot;&gt;Verify and stage&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;color:#26323A;margin-top:4px;&quot;&gt;Validate HTTPS hosts, metadata, SHA-256, archive members, path safety and required files; extract to staging.&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=10;spacingTop=8;spacingBottom=7;fontFamily=Arial;fontSize=12;fontColor=#56390C;fillColor=#FFF4DF;strokeColor=#BA7A19;strokeWidth=1.5;shadow=1;" vertex="1" parent="1">
                    <mxGeometry x="860" y="375" width="220" height="175" as="geometry"/>
                </mxCell>
                <mxCell id="runtime_sync" value="&lt;div style=&quot;font-family:Arial;font-size:13px;font-weight:700;color:#56390C;&quot;&gt;Prepare environment&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;color:#26323A;margin-top:4px;&quot;&gt;Verify pinned uv version; run uv sync --locked --no-dev against staged runtime.&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=10;spacingTop=8;spacingBottom=7;fontFamily=Arial;fontSize=12;fontColor=#56390C;fillColor=#FFF4DF;strokeColor=#BA7A19;strokeWidth=1.5;shadow=1;" vertex="1" parent="1">
                    <mxGeometry x="1110" y="375" width="230" height="175" as="geometry"/>
                </mxCell>
                <mxCell id="runtime_promote" value="&lt;div style=&quot;font-family:Arial;font-size:13px;font-weight:700;color:#173D26;&quot;&gt;Atomic promotion&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;color:#26323A;margin-top:4px;&quot;&gt;Write ready metadata, promote staged runtime, re-verify installed tree.&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=10;spacingTop=8;spacingBottom=7;fontFamily=Arial;fontSize=12;fontColor=#173D26;fillColor=#E8F6ED;strokeColor=#43845D;strokeWidth=1.5;shadow=1;" vertex="1" parent="1">
                    <mxGeometry x="980" y="590" width="240" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="runtime_invocation" value="&lt;div style=&quot;font-family:Arial;font-size:13px;font-weight:700;color:#173D26;&quot;&gt;Run invocation&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;color:#26323A;margin-top:4px;&quot;&gt;uv run --locked python src/Kafe.py &amp;lt;file&amp;gt;&lt;br/&gt;Managed mode adds --no-dev.&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=10;spacingTop=8;spacingBottom=7;fontFamily=Arial;fontSize=12;fontColor=#173D26;fillColor=#E8F6ED;strokeColor=#43845D;strokeWidth=1.5;shadow=1;" vertex="1" parent="1">
                    <mxGeometry x="1400" y="155" width="220" height="165" as="geometry"/>
                </mxCell>
                <mxCell id="runtime_runner" value="&lt;div style=&quot;font-family:Arial;font-size:13px;font-weight:700;color:#173D26;&quot;&gt;kafeRunner.js&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;color:#26323A;margin-top:4px;&quot;&gt;Spawns without a shell; passes interactive stdin; streams output; cancel sends SIGTERM.&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=10;spacingTop=8;spacingBottom=7;fontFamily=Arial;fontSize=12;fontColor=#173D26;fillColor=#E8F6ED;strokeColor=#43845D;strokeWidth=1.5;shadow=1;" vertex="1" parent="1">
                    <mxGeometry x="1645" y="155" width="225" height="165" as="geometry"/>
                </mxCell>
                <mxCell id="runtime_terminalProcess" value="&lt;div style=&quot;font-family:Arial;font-size:13px;font-weight:700;color:#172B4D;&quot;&gt;VS Code pseudoterminal&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;color:#26323A;margin-top:4px;&quot;&gt;Shows live stdout/stderr and accepts learner input while KAFE.py runs.&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=10;spacingTop=8;spacingBottom=7;fontFamily=Arial;fontSize=12;fontColor=#172B4D;fillColor=#EAF2FF;strokeColor=#4776A8;strokeWidth=1.5;shadow=1;" vertex="1" parent="1">
                    <mxGeometry x="1400" y="390" width="220" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="runtime_evidence" value="&lt;div style=&quot;font-family:Arial;font-size:13px;font-weight:700;color:#38245A;&quot;&gt;Run evidence&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;color:#26323A;margin-top:4px;&quot;&gt;Retains stdout/stderr up to 1 MiB total; records truncation, exit code, source URI, sequence, mode and versions.&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=10;spacingTop=8;spacingBottom=7;fontFamily=Arial;fontSize=12;fontColor=#38245A;fillColor=#F2EAFE;strokeColor=#8056B3;strokeWidth=1.5;shadow=1;" vertex="1" parent="1">
                    <mxGeometry x="1645" y="390" width="225" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="runtime_evidenceHost" value="&lt;div style=&quot;font-family:Arial;font-size:13px;font-weight:700;color:#38245A;&quot;&gt;SessionCoordinator&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;color:#26323A;margin-top:4px;&quot;&gt;Accepts validated, increasing Run sequences; associates evidence with source.&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=10;spacingTop=8;spacingBottom=7;fontFamily=Arial;fontSize=12;fontColor=#38245A;fillColor=#F2EAFE;strokeColor=#8056B3;strokeWidth=1.5;shadow=1;" vertex="1" parent="1">
                    <mxGeometry x="1400" y="625" width="220" height="155" as="geometry"/>
                </mxCell>
                <mxCell id="runtime_reviewCheck" value="&lt;div style=&quot;font-family:Arial;font-size:13px;font-weight:700;color:#56390C;&quot;&gt;Learner-reviewed check&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;color:#26323A;margin-top:4px;&quot;&gt;Optional label/outcome linked to a Run; saved to workspaceState. Passing run alone does not prove mastery.&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=10;spacingTop=8;spacingBottom=7;fontFamily=Arial;fontSize=12;fontColor=#56390C;fillColor=#FFF4DF;strokeColor=#BA7A19;strokeWidth=1.5;shadow=1;" vertex="1" parent="1">
                    <mxGeometry x="1645" y="625" width="225" height="155" as="geometry"/>
                </mxCell>
                <mxCell id="runtime_devPack" value="&lt;div style=&quot;font-family:Arial;font-size:13px;font-weight:700;color:#173D26;&quot;&gt;DevelopmentKnowledgePack&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;color:#26323A;margin-top:4px;&quot;&gt;Development extension only. Requires marker files pyproject.toml, uv.lock, src/Kafe.py. Packages six curated docs sections plus src grammar; hashes and caches the pack.&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=10;spacingTop=8;spacingBottom=7;fontFamily=Arial;fontSize=12;fontColor=#173D26;fillColor=#E8F6ED;strokeColor=#43845D;strokeWidth=1.5;shadow=1;" vertex="1" parent="1">
                    <mxGeometry x="50" y="950" width="300" height="205" as="geometry"/>
                </mxCell>
                <mxCell id="runtime_managedPack" value="&lt;div style=&quot;font-family:Arial;font-size:13px;font-weight:700;color:#173D26;&quot;&gt;Managed knowledge pack&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;color:#26323A;margin-top:4px;&quot;&gt;Shipped in verified runtime archive; runtime and knowledge versions must match. Preferred when managed runtime is ready.&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=10;spacingTop=8;spacingBottom=7;fontFamily=Arial;fontSize=12;fontColor=#173D26;fillColor=#E8F6ED;strokeColor=#43845D;strokeWidth=1.5;shadow=1;" vertex="1" parent="1">
                    <mxGeometry x="420" y="950" width="300" height="205" as="geometry"/>
                </mxCell>
                <mxCell id="runtime_retriever" value="&lt;div style=&quot;font-family:Arial;font-size:13px;font-weight:700;color:#38245A;&quot;&gt;KnowledgeRetriever&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;color:#26323A;margin-top:4px;&quot;&gt;Validates root, paths, sizes, versions and dev digest; ranks local passages and selects up to 5 (max 2 per file).&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=10;spacingTop=8;spacingBottom=7;fontFamily=Arial;fontSize=12;fontColor=#38245A;fillColor=#F2EAFE;strokeColor=#8056B3;strokeWidth=1.5;shadow=1;" vertex="1" parent="1">
