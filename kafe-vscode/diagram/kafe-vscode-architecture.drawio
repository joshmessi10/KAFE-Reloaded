                </mxCell>
                <mxCell id="tutorflow_apply" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=10;spacingTop=8;spacingBottom=7;fontFamily=Arial;fontSize=12;fontColor=#56390C;fillColor=#FFF4DF;strokeColor=#BA7A19;strokeWidth=1.5;shadow=1;" value="&lt;div style=&quot;font-family:Arial;font-size:13px;font-weight:700;color:#56390C;&quot;&gt;Explicit accept or reject&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;color:#26323A;margin-top:4px;&quot;&gt;Accept reopens source and checks URI, document version and SHA-256 before WorkspaceEdit. Reject discards.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="130" width="420" x="1460" y="810" as="geometry"/>
                </mxCell>
