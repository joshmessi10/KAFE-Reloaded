    <diagram id="journey" name="1 - The learner journey">
        <mxGraphModel dx="4092" dy="2760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1980" pageHeight="1120" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="journey_heading" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;" value="&lt;div style=&quot;font-family:Arial;font-size:27px;font-weight:700;color:#17324D;&quot;&gt;KAFE Tutor: a learner stays in control&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:14px;color:#52636D;margin-top:4px;&quot;&gt;A guided path from a learning goal to a reviewed result. The learner chooses what to share, change, and run.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="70" width="1884" x="48" y="24" as="geometry"/>
                </mxCell>
                <mxCell id="journey_guardrails_bg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#36516D;strokeWidth=1.2;" value="" vertex="1">
