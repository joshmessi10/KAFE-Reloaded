                </mxCell>
                <mxCell id="journey_status_label" parent="1" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" value="&lt;div style=&quot;font-family:Arial;font-size:15px;font-weight:700;color:#B5871D;&quot;&gt;Current build&lt;/div&gt;" vertex="1">
                    <mxGeometry height="28" width="1852" x="64" y="933" as="geometry"/>
                </mxCell>
                <mxCell id="journey_s1" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=15;spacingRight=13;spacingTop=12;spacingBottom=10;fontFamily=Arial;fillColor=#EAF0F7;strokeColor=#36516D;strokeWidth=1.5;shadow=1;" value="&lt;div style=&quot;font-family:Arial;color:#17324D;&quot;&gt;&lt;div style=&quot;font-size:17px;font-weight:700;line-height:1.2;&quot;&gt;01  Choose a goal&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35;margin-top:9px;color:#293943;&quot;&gt;The learner chooses what to learn or build, then confirms a short plan of next steps.&lt;/div&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="330" width="282" x="-47" y="170" as="geometry"/>
                </mxCell>
                <mxCell id="journey_s2" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=15;spacingRight=13;spacingTop=12;spacingBottom=10;fontFamily=Arial;fillColor=#E5F5F2;strokeColor=#2C8178;strokeWidth=1.5;shadow=1;" value="&lt;div style=&quot;font-family:Arial;color:#164D48;&quot;&gt;&lt;div style=&quot;font-size:17px;font-weight:700;line-height:1.2;&quot;&gt;02  Ask for help&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35;margin-top:9px;color:#293943;&quot;&gt;The learner asks for a hint, explanation, example, or a possible code change.&lt;/div&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="330" width="282" x="440" y="260" as="geometry"/>
                </mxCell>
                <mxCell id="journey_s3" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=15;spacingRight=13;spacingTop=12;spacingBottom=10;fontFamily=Arial;fillColor=#FFF2D8;strokeColor=#B77A22;strokeWidth=1.5;shadow=1;" value="&lt;div style=&quot;font-family:Arial;color:#5D3D10;&quot;&gt;&lt;div style=&quot;font-size:17px;font-weight:700;line-height:1.2;&quot;&gt;03  Review what is shared&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35;margin-top:9px;color:#293943;&quot;&gt;A preview shows the question and any included code, run output, or KAFE lesson excerpts. Nothing is sent until the learner presses Send.&lt;/div&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="330" width="282" x="890" y="70" as="geometry"/>
                </mxCell>
                <mxCell id="journey_s4" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=15;spacingRight=13;spacingTop=12;spacingBottom=10;fontFamily=Arial;fillColor=#F0EAF8;strokeColor=#795A9B;strokeWidth=1.5;shadow=1;" value="&lt;div style=&quot;font-family:Arial;color:#3B2B50;&quot;&gt;&lt;div style=&quot;font-size:17px;font-weight:700;line-height:1.2;&quot;&gt;04  Learn with the tutor&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35;margin-top:9px;color:#293943;&quot;&gt;The AI replies to the reviewed request. If more KAFE material is needed, the tutor refreshes the preview and waits for the learner again.&lt;/div&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="330" width="282" x="1310" y="290" as="geometry"/>
                </mxCell>
                <mxCell id="journey_s5" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=15;spacingRight=13;spacingTop=12;spacingBottom=10;fontFamily=Arial;fillColor=#FCEBE7;strokeColor=#B76552;strokeWidth=1.5;shadow=1;" value="&lt;div style=&quot;font-family:Arial;color:#542B24;&quot;&gt;&lt;div style=&quot;font-size:17px;font-weight:700;line-height:1.2;&quot;&gt;05  Review a suggestion&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35;margin-top:9px;color:#293943;&quot;&gt;A proposed edit opens beside the current file. The learner accepts or rejects it; the tutor does not apply changes silently.&lt;/div&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="330" width="282" x="1310" y="-132" as="geometry"/>
                </mxCell>
                <mxCell id="journey_s6" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=15;spacingRight=13;spacingTop=12;spacingBottom=10;fontFamily=Arial;fillColor=#E5F5F2;strokeColor=#2C8178;strokeWidth=1.5;shadow=1;" value="&lt;div style=&quot;font-family:Arial;color:#164D48;&quot;&gt;&lt;div style=&quot;font-size:17px;font-weight:700;line-height:1.2;&quot;&gt;06  Run and reflect&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35;margin-top:9px;color:#293943;&quot;&gt;The learner chooses Run, sees the program output, and can use that result to guide the next question or record a personal check.&lt;/div&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="330" width="282" x="1810" y="-132" as="geometry"/>
                </mxCell>
                <mxCell id="journey_g1" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=15;spacingRight=13;spacingTop=12;spacingBottom=10;fontFamily=Arial;fillColor=#EAF0F7;strokeColor=#36516D;strokeWidth=1.5;shadow=1;" value="&lt;div style=&quot;font-family:Arial;color:#17324D;&quot;&gt;&lt;div style=&quot;font-size:17px;font-weight:700;line-height:1.2;&quot;&gt;Sharing is your choice&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35;margin-top:9px;color:#293943;&quot;&gt;Only material listed in the preview is sent, and only after you press Send.&lt;/div&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="142" width="560" x="74" y="716" as="geometry"/>
                </mxCell>
                <mxCell id="journey_g2" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=15;spacingRight=13;spacingTop=12;spacingBottom=10;fontFamily=Arial;fillColor=#F0EAF8;strokeColor=#795A9B;strokeWidth=1.5;shadow=1;" value="&lt;div style=&quot;font-family:Arial;color:#3B2B50;&quot;&gt;&lt;div style=&quot;font-size:17px;font-weight:700;line-height:1.2;&quot;&gt;Edits are your choice&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35;margin-top:9px;color:#293943;&quot;&gt;A suggestion is a draft. The file changes only after you review and accept it.&lt;/div&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="142" width="560" x="724" y="716" as="geometry"/>
                </mxCell>
                <mxCell id="journey_g3" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=15;spacingRight=13;spacingTop=12;spacingBottom=10;fontFamily=Arial;fillColor=#E5F5F2;strokeColor=#2C8178;strokeWidth=1.5;shadow=1;" value="&lt;div style=&quot;font-family:Arial;color:#164D48;&quot;&gt;&lt;div style=&quot;font-size:17px;font-weight:700;line-height:1.2;&quot;&gt;Running is your choice&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35;margin-top:9px;color:#293943;&quot;&gt;KAFE runs when you use Run. The AI cannot start a program for you.&lt;/div&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="142" width="520" x="1374" y="716" as="geometry"/>
                </mxCell>
                <mxCell id="journey_statusNote" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=15;spacingRight=13;spacingTop=12;spacingBottom=10;fontFamily=Arial;fillColor=#FFF8DC;strokeColor=#B5871D;strokeWidth=1.5;shadow=1;shape=note;size=16;" value="&lt;div style=&quot;font-family:Arial;color:#4F4018;&quot;&gt;&lt;div style=&quot;font-size:17px;font-weight:700;line-height:1.2;&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35;margin-top:9px;color:#293943;&quot;&gt;Current build: the managed KAFE 0.1.0 download is not yet published. Running still requires a configured developer checkout with compatible uv.&lt;/div&gt;&lt;/div&gt;" vertex="1">
