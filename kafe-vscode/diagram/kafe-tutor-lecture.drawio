                </mxCell>
                <mxCell id="journey_guardrails_label" parent="1" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" value="&lt;div style=&quot;font-family:Arial;font-size:15px;font-weight:700;color:#36516D;&quot;&gt;Three simple rules&lt;/div&gt;" vertex="1">
                    <mxGeometry height="28" width="1852" x="64" y="658" as="geometry"/>
                </mxCell>
                <mxCell id="journey_status_bg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8DC;strokeColor=#B5871D;strokeWidth=1.2;" value="" vertex="1">
